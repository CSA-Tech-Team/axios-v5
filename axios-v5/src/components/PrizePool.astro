---

<section id="prizes" class="cv-auto" style="position:relative;background:var(--ink);color:#f3e7d3;padding:64px 0 72px;background-image:radial-gradient(rgba(255,255,255,.05) 1px,transparent 1px);background-size:22px 22px">
  <img 
    src="/assets/piggy-bank.webp" 
    alt="Piggy bank illustration" 
    width="220" 
    height="220" 
    loading="lazy" 
    decoding="async" 
    style="position:absolute;top:26px;left:-36px;width:clamp(130px,16vw,220px);height:auto;transform:rotate(-10deg);filter:drop-shadow(5px 6px 0 rgba(0,0,0,.4));pointer-events:none" 
  />
  <img 
    src="/assets/dollar-bill.webp" 
    alt="Dollar bill illustration" 
    width="270" 
    height="160" 
    data-bill="1" 
    loading="lazy" 
    decoding="async" 
    style="position:absolute;bottom:-62px;right:70px;z-index:3;opacity:0;width:clamp(160px,20vw,270px);height:auto;transform:rotate(12deg) scaleX(-1);filter:drop-shadow(5px 6px 0 rgba(0,0,0,.4));pointer-events:none" 
  />

  <div style="position:relative;max-width:1180px;margin:0 auto;padding:0 24px;text-align:center">
    <div style="position:relative;display:inline-block;margin-top:26px">
      <div style="font-family:'Anton',sans-serif;font-size:clamp(72px,16vw,220px);line-height:.85;letter-spacing:.01em;color:#f3e7d3;transform:rotate(-1.5deg);text-shadow:4px 4px 0 var(--r1),8px 8px 0 var(--r3),12px 12px 0 var(--r5),16px 16px 0 var(--r6)">₹1,50,000</div>
      <div style="position:absolute;bottom:-30px;right:-26px;font-family:'Shrikhand',serif;font-size:clamp(17px,2.8vw,26px);color:var(--acc2);transform:rotate(3.5deg)">up for grabs!</div>
    </div>
    <div style="margin:34px auto 0;max-width:36em;font-size:16px;line-height:1.6;color:#c9b48c">Excellence awaits the worthy at Axios. Do you have what it takes to bag it all and walk home a little heavier?</div>
    <div style="margin-top:30px">
      <a 
        href="#register" 
        data-go="register" 
        style="display:inline-flex;align-items:center;gap:9px;background:var(--acc);color:#fff;font-size:16px;font-weight:700;padding:14px 28px;border:3px solid #f3e7d3;box-shadow:6px 6px 0 rgba(243,231,211,.35)"
      >
        ▶ Claim a seat
      </a>
    </div>
  </div>
</section>

<script>
  function initBillCrawl() {
    const bill = document.querySelector('[data-bill]');
    const prizesSection = document.getElementById('prizes');
    if (!bill || !prizesSection || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = bill as HTMLElement;
          if (!el.style.animation) {
            el.style.animation = 'billCrawl 1.15s linear .25s both';
          }
        }
      });
    }, { threshold: 0.2 });

    observer.observe(prizesSection);
  }

  document.addEventListener('DOMContentLoaded', initBillCrawl);
</script>
