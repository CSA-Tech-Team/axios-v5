---
---

<section id="team" class="cv-auto" style="position:relative;max-width:1180px;margin:0 auto;padding:56px 24px">
  <span style="position:absolute;top:22px;right:20px;color:var(--acc);opacity:.45;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="0" x2="12" y2="24"></line><line x1="0" y1="12" x2="24" y2="12"></line></svg>
  </span>
  <span style="position:absolute;bottom:22px;left:20px;color:var(--r5);opacity:.45;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="0" x2="12" y2="24"></line><line x1="0" y1="12" x2="24" y2="12"></line></svg>
  </span>
  <img 
    src="/assets/camera-hand.webp" 
    alt="Camera hand illustration" 
    width="164" 
    height="164" 
    loading="lazy" 
    decoding="async"
    style="position:absolute;top:14px;right:34px;z-index:1;width:clamp(100px,13vw,164px);height:auto;pointer-events:none;transform:rotate(7deg);mix-blend-mode:multiply" 
  />

  <h2 style="margin:0 0 30px;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(48px,9vw,112px);line-height:.82;letter-spacing:-.03em;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">MEET THE TEAM</h2>
  
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:22px">
    <!-- 1. Secretary -->
    <div class="tcard" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:12px 12px 18px;transform:rotate(1.1deg);transition:transform .3s,box-shadow .3s">
      <div style="position:absolute;top:-11px;left:50%;transform:translateX(-50%) rotate(-4deg);width:88px;height:22px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:4"></div>
      <span style="position:relative;display:block">
        <img 
          src="/assets/court-statue.webp" 
          alt="Secretary - Dinesh" 
          width="200" 
          height="184" 
          loading="lazy"
          decoding="async"
          style="display:block;width:100%;height:184px;object-fit:cover" 
        />
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.16"></span>
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.09"></span>
      </span>
      <div style="font-family:'Shrikhand',serif;font-size:15px;color:var(--acc);margin-top:12px">Secretary</div>
      <div style="font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;font-size:clamp(20px,3.2vw,28px);line-height:1;color:var(--ink);margin-top:2px;text-shadow:0 1px 0 #fbf5e8,2px 0 0 rgba(226,59,46,.4),-2px 1px 0 rgba(47,143,208,.34)">Dinesh</div>
    </div>

    <!-- 2. Joint Secretary -->
    <div class="tcard" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:12px 12px 18px;transform:rotate(-1deg);transition:transform .3s,box-shadow .3s">
      <div style="position:absolute;top:-11px;left:50%;transform:translateX(-50%) rotate(5deg);width:88px;height:22px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:4"></div>
      <span style="position:relative;display:block">
        <img 
          src="/assets/eye-crop.webp" 
          alt="Joint Secretary - Thithiksha" 
          width="200" 
          height="184" 
          loading="lazy"
          decoding="async"
          style="display:block;width:100%;height:184px;object-fit:cover" 
        />
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.16"></span>
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.09"></span>
      </span>
      <div style="font-family:'Shrikhand',serif;font-size:15px;color:var(--acc);margin-top:12px">Joint Secretary</div>
      <div style="font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;font-size:clamp(20px,3.2vw,28px);line-height:1;color:var(--ink);margin-top:2px;text-shadow:0 1px 0 #fbf5e8,2px 0 0 rgba(226,59,46,.4),-2px 1px 0 rgba(47,143,208,.34)">Thithiksha</div>
    </div>

    <!-- 3. Treasurer -->
    <div class="tcard" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:12px 12px 18px;transform:rotate(1.4deg);transition:transform .3s,box-shadow .3s">
      <div style="position:absolute;top:-11px;left:50%;transform:translateX(-50%) rotate(-3deg);width:88px;height:22px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:4"></div>
      <span style="position:relative;display:block">
        <img 
          src="/assets/lens-cut.webp" 
          alt="Treasurer - Ashvanth" 
          width="200" 
          height="184" 
          loading="lazy"
          decoding="async"
          style="display:block;width:100%;height:184px;object-fit:cover" 
        />
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.16"></span>
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.09"></span>
      </span>
      <div style="font-family:'Shrikhand',serif;font-size:15px;color:var(--acc);margin-top:12px">Treasurer</div>
      <div style="font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;font-size:clamp(20px,3.2vw,28px);line-height:1;color:var(--ink);margin-top:2px;text-shadow:0 1px 0 #fbf5e8,2px 0 0 rgba(226,59,46,.4),-2px 1px 0 rgba(47,143,208,.34)">Ashvanth</div>
    </div>

    <!-- 4. Executive Coordinator -->
    <div class="tcard" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:12px 12px 18px;transform:rotate(-1.2deg);transition:transform .3s,box-shadow .3s">
      <div style="position:absolute;top:-11px;left:50%;transform:translateX(-50%) rotate(4deg);width:88px;height:22px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:4"></div>
      <span style="position:relative;display:block">
        <img 
          src="/assets/thinker-halftone.webp" 
          alt="Executive Coordinator - Bhuvanesh" 
          width="200" 
          height="184" 
          loading="lazy"
          decoding="async"
          style="display:block;width:100%;height:184px;object-fit:cover" 
        />
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.16"></span>
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.09"></span>
      </span>
      <div style="font-family:'Shrikhand',serif;font-size:15px;color:var(--acc);margin-top:12px">Executive Coordinator</div>
      <div style="font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;font-size:clamp(20px,3.2vw,28px);line-height:1;color:var(--ink);margin-top:2px;text-shadow:0 1px 0 #fbf5e8,2px 0 0 rgba(226,59,46,.4),-2px 1px 0 rgba(47,143,208,.34)">Bhuvanesh</div>
    </div>

    <!-- 5. Convenor -->
    <div class="tcard" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:12px 12px 18px;transform:rotate(-1.4deg);transition:transform .3s,box-shadow .3s">
      <div style="position:absolute;top:-11px;left:50%;transform:translateX(-50%) rotate(3deg);width:88px;height:22px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:4"></div>
      <span style="position:relative;display:block">
        <img 
          src="/assets/heart-hands.webp" 
          alt="Convenor - Ravi Varma" 
          width="200" 
          height="184" 
          loading="lazy"
          decoding="async"
          style="display:block;width:100%;height:184px;object-fit:cover" 
        />
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.16"></span>
        <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.09"></span>
      </span>
      <div style="font-family:'Shrikhand',serif;font-size:15px;color:var(--acc);margin-top:12px">Convenor</div>
      <div style="font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;font-size:clamp(20px,3.2vw,28px);line-height:1;color:var(--ink);margin-top:2px;text-shadow:0 1px 0 #fbf5e8,2px 0 0 rgba(226,59,46,.4),-2px 1px 0 rgba(47,143,208,.34)">Ravi Varma</div>
    </div>
  </div>
</section>
