---
---

<section id="events" class="cv-auto" style="max-width:1180px;margin:0 auto;padding:52px 24px">
  <!-- Festival Poster Lineup: Gig-bill Paste-up -->
  <div style="display:flex;flex-direction:column;align-items:center;gap:10px;margin-bottom:8px">
    <div style="display:flex;align-items:center;gap:14px;width:100%;max-width:760px;margin-bottom:10px">
      <span style="height:2px;flex:1;background:var(--ink)"></span>
      <span style="font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);white-space:nowrap">The Event Lineup</span>
      <span style="color:var(--acc);font-size:13px">✦</span>
      <span style="font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink2);white-space:nowrap">8 arenas · 2 days</span>
      <span style="height:2px;flex:1;background:var(--ink)"></span>
    </div>

    <!-- Festival Poster Typography & Hover Previews -->
    <span style="position:relative;display:inline-block">
      <a 
        href="#e-qz" 
        data-open="qz" 
        data-court-trigger="qf" 
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(48px,10vw,120px);color:var(--ink);transform:skewX(-6deg) rotate(.6deg);text-shadow:5px 5px 0 var(--r5)"
        onmouseover="this.style.color='var(--r5)'"
        onmouseout="this.style.color='var(--ink)'"
      >
        QFACTOR
      </a>
      <img 
        src="/assets/thinker-halftone.webp" 
        alt="" 
        width="132" 
        height="132" 
        data-court="qf" 
        loading="lazy"
        decoding="async"
        style="position:absolute;right:-118px;top:-58px;width:132px;height:auto;opacity:0;transform:rotate(6deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);mix-blend-mode:multiply;pointer-events:none" 
      />
    </span>

    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:6px 26px">
      <span style="position:relative;display:inline-block">
        <a 
          href="#e-brc" 
          data-open="brc" 
          data-court-trigger="brc" 
          style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(34px,6.5vw,76px);color:transparent;-webkit-text-stroke:2.5px var(--acc);transform:rotate(1deg) translateY(2px)"
          onmouseover="this.style.webkitTextStrokeColor='var(--ink)'"
          onmouseout="this.style.webkitTextStrokeColor='var(--acc)'"
        >
          BREACH POINT
        </a>
        <img 
          src="/assets/eye-crop.webp" 
          alt="" 
          width="150" 
          height="150" 
          data-court="brc" 
          loading="lazy"
          decoding="async"
          style="position:absolute;left:-34px;top:-66px;width:150px;height:auto;opacity:0;transform:rotate(-4deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);border:1.5px solid var(--ink);box-shadow:4px 4px 0 rgba(36,26,18,.3);pointer-events:none" 
        />
      </span>
      <span style="color:var(--acc2);font-size:clamp(18px,3vw,30px);transform:rotate(12deg)">✶</span>
      <span style="position:relative;display:inline-block">
        <a 
          href="#e-dq" 
          data-open="dq" 
          data-court-trigger="dq" 
          style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(34px,6.5vw,76px);color:var(--ink);text-shadow:3px 3px 0 var(--r3);transform:rotate(-.9deg)"
          onmouseover="this.style.color='var(--r4)'"
          onmouseout="this.style.color='var(--ink)'"
        >
          DATAQUEST
        </a>
        <img 
          src="/assets/lens-cut.webp" 
          alt="" 
          width="126" 
          height="126" 
          data-court="dq" 
          loading="lazy"
          decoding="async"
          style="position:absolute;right:-30px;top:-84px;width:126px;height:auto;opacity:0;transform:rotate(9deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);filter:drop-shadow(4px 5px 0 rgba(36,26,18,.24));pointer-events:none" 
        />
      </span>
    </div>

    <span style="position:relative;display:inline-block;transform:rotate(-1.4deg)">
      <a 
        href="#e-tri" 
        data-open="tri" 
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(44px,9vw,110px);color:var(--ink);text-shadow:-4px 3px 0 var(--acc2)"
        onmouseover="this.style.color='var(--r1)'"
        onmouseout="this.style.color='var(--ink)'"
      >
        TECH TRIATHLON
      </a>
      <span aria-hidden="true" style="position:absolute;left:-26px;top:-14px;font-size:clamp(20px,3.4vw,40px);color:var(--acc2);animation:twk 2.4s ease-in-out infinite;pointer-events:none">✦</span>
      <span aria-hidden="true" style="position:absolute;right:-20px;top:6px;font-size:clamp(16px,2.6vw,30px);color:var(--r1);animation:twk 2.4s ease-in-out .8s infinite;pointer-events:none">✦</span>
    </span>

    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:6px 26px">
      <a 
        href="#e-mm" 
        data-open="mm" 
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(32px,6vw,70px);color:var(--r6);background:repeating-linear-gradient(-16deg,var(--r6) 0 5px,var(--r7) 5px 10px);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;transform:rotate(1.2deg)"
      >
        MATH MANIA
      </a>
      <span style="color:var(--acc);font-size:clamp(18px,3vw,30px);transform:rotate(-8deg)">✶</span>
      <span style="position:relative;display:inline-block">
        <a 
          href="#e-svc" 
          data-open="svc" 
          data-court-trigger="svc" 
          style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(32px,6vw,70px);color:var(--paper);background:var(--ink);padding:2px 12px 5px;transform:rotate(-1deg) translateY(-3px)"
          onmouseover="this.style.color='var(--acc2)'"
          onmouseout="this.style.color='var(--paper)'"
        >
          SURVIVORS' COURT
        </a>
        <img 
          src="/assets/court-statue-sm.webp" 
          alt="" 
          width="150" 
          height="150" 
          data-court="svc" 
          loading="lazy"
          decoding="async"
          style="position:absolute;right:-96px;top:-124px;width:150px;height:auto;opacity:0;transform:rotate(-7deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);mix-blend-mode:multiply;pointer-events:none" 
        />
      </span>
    </div>

    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:14px 22px;margin-top:2px">
      <span style="font-family:'Shrikhand',serif;font-size:clamp(16px,2.6vw,26px);color:var(--r2);transform:rotate(-5deg)">plus</span>
      <span style="position:relative;display:inline-block">
        <span data-court-trigger="go" style="font-family:'Anton',sans-serif;font-size:clamp(44px,8.5vw,104px);line-height:.85;color:var(--r7);display:inline-block;transform:rotate(.8deg) skewX(-4deg);text-shadow:5px 5px 0 var(--ink)">GAME OVER</span>
        <img 
          src="/assets/jett-crop.webp" 
          alt="" 
          width="115" 
          height="115" 
          data-court="go" 
          loading="lazy"
          decoding="async"
          style="position:absolute;left:-46px;top:74px;width:115px;height:auto;opacity:0;transform:rotate(-6deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);border:1.5px solid var(--ink);box-shadow:4px 4px 0 rgba(36,26,18,.3);pointer-events:none" 
        />
      </span>
      <span style="display:flex;flex-direction:column;gap:10px">
        <a href="#e-val" data-open="val" style="font-family:inherit;font-size:clamp(13px,1.8vw,17px);font-weight:700;letter-spacing:.08em;color:var(--ink);background:var(--card);border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:7px 14px;transform:rotate(-3deg);transition:transform .15s">▸ VALORANT</a>
        <a href="#e-fifa" data-open="fifa" style="font-family:inherit;font-size:clamp(13px,1.8vw,17px);font-weight:700;letter-spacing:.08em;color:var(--ink);background:var(--acc2);border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:7px 14px;transform:rotate(2.5deg);transition:transform .15s">▸ FIFA</a>
      </span>
    </div>
  </div>

  <div style="text-align:center;margin-top:18px">
    <span style="font-family:'Shrikhand',serif;font-size:clamp(14px,2vw,19px);color:var(--r5);display:inline-block;text-transform:none">✂ tap any name for the full brief</span>
  </div>

  <!-- Event Cards Grid -->
  <div style="display:flex;flex-direction:column;gap:16px;margin-top:32px">
    <!-- Technical Events Subheading -->
    <div style="display:flex;align-items:baseline;gap:14px;color:var(--acc)">
      <span style="font-family:'Shrikhand',serif;font-size:clamp(20px,3vw,28px);transform:rotate(1.6deg);display:inline-block">technical events</span>
      <span style="height:2px;flex:1;background:var(--line);align-self:center"></span>
    </div>
    
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px">
      <!-- 1. Technical Triathlon -->
      <div id="e-tri" class="ecard" data-open="tri" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--ink);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(-1deg);cursor:pointer">
        <div style="position:absolute;top:-16px;left:-12px;z-index:5;transform:rotate(-10deg);display:flex;flex-direction:column;align-items:center;gap:1px;pointer-events:none">
          <svg width="34" height="26" viewBox="0 0 34 26" style="display:block"><path d="M3 22 L1.5 7 L9.5 13 L17 2.5 L24.5 13 L32.5 7 L31 22 Z" fill="#f0a500" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"></path><circle cx="17" cy="17" r="2" fill="var(--ink)"></circle></svg>
          <span style="font-family:inherit;font-size:9px;font-weight:700;letter-spacing:.1em;color:#fff;background:var(--ink);padding:2px 6px 1px">SIGNATURE</span>
        </div>
        <img src="/assets/logo-tri.webp" alt="Technical Triathlon Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">RELAY · 3 ROUNDS</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Technical Triathlon</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">Three back-to-back rounds against the clock — code, logic, build. One team, one relay.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹60,000</span>
        </div>
      </div>

      <!-- 2. Breach Point -->
      <div id="e-brc" class="ecard" data-open="brc" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--acc);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(.8deg) translateY(6px);cursor:pointer">
        <img src="/assets/logo-brc.webp" alt="Breach Point CTF Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">CTF · 5 TRACKS</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Breach Point</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">A capture-the-flag arena. Crypto, web, forensics, reversing. Find the flag, own the board.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹75,000</span>
        </div>
      </div>

      <!-- 3. DataQuest -->
      <div id="e-dq" class="ecard" data-open="dq" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--r3);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(-.6deg);cursor:pointer">
        <img src="/assets/logo-dq.webp" alt="DataQuest Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">DATA · 2 ROUNDS</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">DataQuest</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">A dataset, a deadline, and a story to find in the noise. Model it, explain it, defend it.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹70,000</span>
        </div>
      </div>

      <!-- 4. Math Mania -->
      <div id="e-mm" class="ecard" data-open="mm" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--r6);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(-.9deg) translateY(4px);cursor:pointer">
        <img src="/assets/logo-mm.webp" alt="Math Mania Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">MATH · 2 ROUNDS</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Math Mania</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">An integration bee with teeth. From clean substitutions to problems that fight back.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹50,000</span>
        </div>
      </div>
    </div>

    <div style="height:14px"></div>

    <!-- Non-Technical Events Subheading -->
    <div style="display:flex;align-items:baseline;gap:14px;color:var(--r5)">
      <span style="font-family:'Shrikhand',serif;font-size:clamp(20px,3vw,28px);transform:rotate(-2.4deg);display:inline-block">non-technical events</span>
      <span style="height:2px;flex:1;background:var(--line);align-self:center"></span>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:18px">
      <!-- 5. QFactor -->
      <div id="e-qz" class="ecard" data-open="qz" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--r5);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(1deg) translateY(-5px);cursor:pointer">
        <img src="/assets/logo-qz.webp" alt="QFactor Quiz Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">QUIZ · PRELIM+FINAL</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">QFactor</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">Prelims to knockout finals. Tech, trivia and lateral thinking on the buzzer. Boot your brain.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹45,000</span>
        </div>
      </div>

      <!-- 6. Survivors' Court -->
      <div id="e-svc" class="ecard" data-open="svc" style="position:relative;background:var(--card);border:2px dashed var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--ink);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(.7deg);cursor:pointer">
        <img src="/assets/logo-svc.webp" alt="Survivors' Court Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">STRATEGY · ELIMINATION</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Survivors' Court</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">Alliances, betrayals and one immunity token. Outwit the room across rounds of negotiation — then survive the vote.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹40,000</span>
        </div>
      </div>

      <!-- 7. Game Over - Valorant -->
      <div id="e-val" class="ecard" data-open="val" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--acc2);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(-.8deg) translateY(5px);cursor:pointer">
        <img src="/assets/logo-val.webp" alt="Valorant Gaming Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">5v5 · KNOCKOUT</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Game Over — Valorant</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">Five-a-side tactical shooter on a single-elimination bracket. Clutch the round, take the map, advance.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹55,000</span>
        </div>
      </div>

      <!-- 8. Game Over - FIFA -->
      <div id="e-fifa" class="ecard" data-open="fifa" style="position:relative;background:var(--card);border:2px solid var(--ink);padding:22px 20px;box-shadow:5px 5px 0 var(--ink);transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;scroll-margin-top:70px;transform:rotate(1.1deg) translateY(-3px);cursor:pointer">
        <img src="/assets/logo-fifa.webp" alt="FIFA Gaming Logo" width="62" height="62" loading="lazy" decoding="async" style="width:62px;height:62px;display:block;margin-bottom:14px" />
        <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">1v1 · KNOCKOUT</div>
        <div style="font-size:20px;font-weight:700;margin-bottom:8px">Game Over — FIFA</div>
        <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">One on one on the pitch. Short halves, single-elimination, and the golden boot on the line.</div>
        <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
          <span style="font-family:inherit;font-size:11px;color:var(--ink2)">PRIZE</span>
          <span style="font-size:20px;font-weight:800;color:var(--acc)">₹30,000</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initCourtTriggers() {
    document.querySelectorAll('[data-court-trigger]').forEach((trigger) => {
      const targetId = trigger.getAttribute('data-court-trigger');
      const img = document.querySelector(`[data-court="${targetId}"]`) as HTMLElement;
      if (!img) return;
      const baseTransform = img.style.transform;

      const show = () => {
        img.style.opacity = '1';
        img.style.transform = baseTransform.replace('translateY(6px)', 'translateY(0)');
      };
      const hide = () => {
        img.style.opacity = '0';
        img.style.transform = baseTransform;
      };

      trigger.addEventListener('mouseenter', show);
      trigger.addEventListener('mouseleave', hide);
      trigger.addEventListener('focus', show);
      trigger.addEventListener('blur', hide);
    });
  }

  document.addEventListener('DOMContentLoaded', initCourtTriggers);
</script>
