<section id="register" class="cv-auto" style="position:relative;background:var(--acc);color:#fff;padding:68px 0 70px;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink)">
  <!-- Scalloped Stamp Edge Top -->
  <div style="position:absolute;top:0;left:0;right:0;height:13px;background-image:radial-gradient(circle at 50% 0,var(--paper) 12px,transparent 12.5px);background-size:34px 26px;background-position:center top;background-repeat:repeat-x;pointer-events:none"></div>
  <!-- Scalloped Stamp Edge Bottom -->
  <div style="position:absolute;bottom:0;left:0;right:0;height:13px;background-image:radial-gradient(circle at 50% 100%,var(--paper) 12px,transparent 12.5px);background-size:34px 26px;background-position:center bottom;background-repeat:repeat-x;pointer-events:none"></div>

  <div style="max-width:1180px;margin:0 auto;padding:0 24px">
    <div style="display:inline-block;position:relative;margin:30px 74px 30px 0;transform:rotate(-1deg);max-width:100%">
      <!-- Hanger Clip Tab on top of frame -->
      <span aria-hidden="true" style="position:absolute;left:50%;top:-30px;transform:translateX(-50%);display:block;width:36px;height:36px">
        <span style="position:absolute;left:50%;transform:translateX(-50%);top:0;width:24px;height:15px;background:var(--acc);border:3px solid var(--ink)"></span>
        <span style="position:absolute;left:50%;transform:translateX(-50%);top:14px;width:36px;height:22px;background:var(--acc2);border:3px solid var(--ink)"></span>
      </span>

      <!-- Cabinet Card Frame -->
      <div id="slot-cabinet" style="position:relative;background:var(--card);color:var(--ink);border:4px solid var(--ink);box-shadow:10px 10px 0 var(--ink);padding:16px 20px 18px">
        <!-- Frame Header -->
        <div style="text-align:center;font-family:'Futura','Jost','Century Gothic',sans-serif;font-weight:900;font-size:clamp(28px,3.6vw,46px);letter-spacing:-.01em;line-height:.9;color:var(--ink);margin:2px 0 12px;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">
          GRAB YOUR PASS
        </div>

        <!-- 3 Reels Container -->
        <div style="position:relative;background:var(--ink);padding:12px;display:flex;gap:12px;justify-content:center">
          <!-- Reel 1 -->
          <span style="display:block;position:relative;width:clamp(108px,15vw,206px);height:270px;overflow:hidden;background:var(--wcard)">
            <span aria-hidden="true" style="position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(36,26,18,.5) 0%,rgba(36,26,18,.12) 18%,rgba(255,255,255,0) 34%,rgba(255,255,255,.42) 50%,rgba(255,255,255,0) 66%,rgba(36,26,18,.12) 82%,rgba(36,26,18,.5) 100%)"></span>
            <span id="reel-1" style="display:block;transform:translateY(-30px)">
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--acc2)">⌗</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:60px;color:var(--acc);text-shadow:3px 3px 0 var(--acc2)">FREE</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--r5)">AX</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/thinker-halftone.webp" alt="" width="80" height="80" style="max-height:80px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">⌗</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/piggy-bank.webp" alt="" width="78" height="78" style="max-height:78px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">50%</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/eye-crop.webp" alt="" width="72" height="72" style="max-height:72px;max-width:80%;border:1.5px solid var(--ink);mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">AX</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/crown-doodle.webp" alt="" width="74" height="74" style="max-height:74px;max-width:80%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">⌗</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--acc2)">99%</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:60px;color:var(--acc);text-shadow:3px 3px 0 var(--acc2)">FREE</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">AX</span>
            </span>
          </span>

          <!-- Reel 2 -->
          <span style="display:block;position:relative;width:clamp(108px,15vw,206px);height:270px;overflow:hidden;background:var(--wcard)">
            <span aria-hidden="true" style="position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(36,26,18,.5) 0%,rgba(36,26,18,.12) 18%,rgba(255,255,255,0) 34%,rgba(255,255,255,.42) 50%,rgba(255,255,255,0) 66%,rgba(36,26,18,.12) 82%,rgba(36,26,18,.5) 100%)"></span>
            <span id="reel-2" style="display:block;transform:translateY(-30px)">
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/piggy-bank.webp" alt="" width="78" height="78" style="max-height:78px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--acc2)">AX</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">⌗</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/lens-cut.webp" alt="" width="76" height="76" style="max-height:76px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">₹</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/thinker-halftone.webp" alt="" width="80" height="80" style="max-height:80px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">PAID</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--r5)">AX</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/dollar-bill.webp" alt="" width="70" height="70" style="max-height:70px;max-width:84%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--acc2)">⌗</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">✶</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--r5)">$$$</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:60px;color:var(--acc);text-shadow:3px 3px 0 var(--acc2)">FREE</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">AX</span>
            </span>
          </span>

          <!-- Reel 3 -->
          <span style="display:block;position:relative;width:clamp(108px,15vw,206px);height:270px;overflow:hidden;background:var(--wcard)">
            <span aria-hidden="true" style="position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(36,26,18,.5) 0%,rgba(36,26,18,.12) 18%,rgba(255,255,255,0) 34%,rgba(255,255,255,.42) 50%,rgba(255,255,255,0) 66%,rgba(36,26,18,.12) 82%,rgba(36,26,18,.5) 100%)"></span>
            <span id="reel-3" style="display:block;transform:translateY(-30px)">
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">✶</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:60px;color:var(--acc);text-shadow:3px 3px 0 var(--acc2)">FREE</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/lens-cut.webp" alt="" width="76" height="76" style="max-height:76px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--acc2)">AX</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">⌗</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/piggy-bank.webp" alt="" width="78" height="78" style="max-height:78px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">₹</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/thinker-halftone.webp" alt="" width="80" height="80" style="max-height:80px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">AX</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--r5)">⌗</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">₹</span>
              <span style="display:grid;place-items:center;height:110px"><img src="/assets/camera-hand.webp" alt="" width="78" height="78" style="max-height:78px;max-width:82%;mix-blend-mode:multiply" /></span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:60px;color:var(--acc);text-shadow:3px 3px 0 var(--acc2)">FREE</span>
              <span style="display:grid;place-items:center;height:110px;font-family:'Anton',sans-serif;font-size:50px;color:var(--ink)">AX</span>
            </span>
          </span>
        </div>

        <!-- Reel Result Footer Message -->
        <div style="margin:14px 8px 0;padding:6px 14px;text-align:center;font-family:'Shrikhand',serif;font-size:clamp(16px,2.3vw,24px);letter-spacing:.08em;line-height:1.15;color:var(--acc)">
          <span id="slot-msg" style="display:inline-block">pull the lever</span>
        </div>
      </div>

      <!-- Twinkle Sparkles around Cabinet -->
      <div id="slot-sparkles" style="display:none">
        <span aria-hidden="true" style="position:absolute;left:-22px;top:-26px;color:var(--acc);font-size:30px;pointer-events:none;animation:twk 1.3s ease-in-out infinite">✶</span>
        <span aria-hidden="true" style="position:absolute;right:26%;top:-34px;color:var(--acc2);font-size:24px;pointer-events:none;animation:twk 1.3s ease-in-out .35s infinite">✶</span>
        <span aria-hidden="true" style="position:absolute;right:-28px;top:60px;color:var(--r5);font-size:34px;pointer-events:none;animation:twk 1.3s ease-in-out .6s infinite">✶</span>
        <span aria-hidden="true" style="position:absolute;left:-28px;bottom:90px;color:var(--acc2);font-size:22px;pointer-events:none;animation:twk 1.3s ease-in-out .85s infinite">✶</span>
        <span aria-hidden="true" style="position:absolute;right:-16px;bottom:-16px;color:var(--acc);font-size:26px;pointer-events:none;animation:twk 1.3s ease-in-out 1.05s infinite">✶</span>
      </div>

      <!-- Lever Mechanism -->
      <span id="slot-lever-btn" title="Pull the lever!" style="position:absolute;right:-62px;top:24%;width:66px;height:230px;cursor:pointer;display:block">
        <span style="position:absolute;left:0;top:48px;width:24px;height:66px;background:var(--ink)"></span>
        <span style="position:absolute;left:22px;top:56px;width:11px;height:146px;background:var(--ink)"></span>
        <span id="lever-knob" style="position:absolute;left:8px;top:30px;width:38px;height:38px;background:var(--acc);border:3px solid var(--ink);box-shadow:3px 3px 0 var(--ink);transition:top .24s cubic-bezier(.4,1.8,.5,1)"></span>
      </span>
    </div>

    <!-- Description Copy -->
    <p style="margin:0 0 28px;font-size:16px;max-width:40em;color:#ffeadd">Your free pass includes entry to every event, meals, and a delegate kit. No prior installation required.</p>

    <!-- 3-Step Wizard Navigation -->
    <div style="display:flex;align-items:center;gap:10px;font-family:inherit;font-size:12px;margin-bottom:22px;flex-wrap:wrap">
      <span class="wstep" data-step="1" style="background:var(--wcard);color:var(--acc);padding:6px 12px;font-weight:700;border:2px solid var(--ink)">1 · Choose events</span>
      <span style="color:#ffcdb8">──</span>
      <span class="wstep" data-step="2" style="background:transparent;color:#ffcdb8;padding:6px 12px;border:2px solid #ffffff55">2 · Your details</span>
      <span style="color:#ffcdb8">──</span>
      <span class="wstep" data-step="3" style="background:transparent;color:#ffcdb8;padding:6px 12px;border:2px solid #ffffff55">3 · Confirm seat</span>
    </div>

    <!-- Step Controls -->
    <div style="display:flex;align-items:center;gap:14px;margin-top:24px;flex-wrap:wrap">
      <span class="wlabel" style="font-family:inherit;font-size:13px;color:#ffeadd">Step 1 of 3</span>
      <div style="display:flex;gap:12px">
        <button class="wback" style="background:transparent;color:#fff;border:2px solid #fff;padding:11px 20px;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer">◀ Back</button>
        <button class="wnext" style="background:var(--wcard);color:var(--acc);border:2px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:11px 22px;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer">Next ▶</button>
      </div>
    </div>
  </div>
</section>

<script>
  function initSlotMachine() {
    const leverBtn = document.getElementById('slot-lever-btn');
    const leverKnob = document.getElementById('lever-knob');
    const r1 = document.getElementById('reel-1');
    const r2 = document.getElementById('reel-2');
    const r3 = document.getElementById('reel-3');
    const msg = document.getElementById('slot-msg');
    const cabinet = document.getElementById('slot-cabinet');
    const sparkles = document.getElementById('slot-sparkles');
    let spinning = false;

    if (leverBtn && leverKnob && r1 && r2 && r3 && msg) {
      const pullLever = () => {
        if (spinning) return;
        spinning = true;

        if (sparkles) sparkles.style.display = 'none';

        // Lever knob pull animation
        leverKnob.style.top = '162px';
        setTimeout(() => { leverKnob.style.top = '30px'; }, 300);

        msg.textContent = 'spinning…';
        msg.style.animation = 'bl .45s steps(1) infinite';

        // Reel blur and spin reset
        [r1, r2, r3].forEach(r => {
          r.style.transition = 'none';
          r.style.transform = 'translateY(-30px)';
          r.style.filter = 'blur(2.5px)';
        });

        setTimeout(() => {
          r1.style.transition = 'transform 1.7s cubic-bezier(.25,.9,.3,1.14)';
          r1.style.transform = 'translateY(-1240px)';
        }, 80);

        setTimeout(() => {
          r2.style.transition = 'transform 2.2s cubic-bezier(.25,.9,.3,1.14)';
          r2.style.transform = 'translateY(-1240px)';
        }, 200);

        setTimeout(() => {
          r3.style.transition = 'transform 2.7s cubic-bezier(.25,.9,.3,1.14)';
          r3.style.transform = 'translateY(-1240px)';
        }, 320);

        // Completion & Jackpot
        setTimeout(() => {
          spinning = false;
          [r1, r2, r3].forEach(r => r.style.filter = 'blur(0px)');
          msg.style.animation = 'none';
          msg.textContent = 'jackpot! pass on the house ✶';
          if (cabinet) cabinet.style.animation = 'slotShake .45s steps(4) 1';
          if (sparkles) sparkles.style.display = 'block';
        }, 3000);
      };

      leverBtn.addEventListener('click', pullLever);
    }

    // Step Wizard Logic
    let currentStep = 1;
    const steps = Array.from(document.querySelectorAll('.wstep'));
    const label = document.querySelector('.wlabel');
    const nextBtn = document.querySelector('.wnext');
    const backBtn = document.querySelector('.wback');

    const updateWizard = () => {
      steps.forEach((s) => {
        const el = s as HTMLElement;
        const n = parseInt(el.getAttribute('data-step') || '1', 10);
        const on = n === currentStep;
        el.style.background = on ? '#fff' : 'transparent';
        el.style.color = on ? 'var(--acc)' : '#ffcdb8';
        el.style.fontWeight = on ? '700' : '400';
        el.style.borderColor = on ? 'var(--ink)' : '#ffffff55';
      });
      if (label) label.textContent = `Step ${currentStep} of 3`;
      if (nextBtn) nextBtn.textContent = currentStep === 3 ? '✓ Finish' : 'Next ▶';
    };

    if (nextBtn && backBtn) {
      nextBtn.addEventListener('click', () => {
        if (currentStep < 3) {
          currentStep++;
          updateWizard();
        }
      });
      backBtn.addEventListener('click', () => {
        if (currentStep > 1) {
          currentStep--;
          updateWizard();
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initSlotMachine);
</script>
