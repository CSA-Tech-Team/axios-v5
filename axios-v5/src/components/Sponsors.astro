---
---

<div style="height:2px;background:var(--ink)"></div>
<section id="sponsors" class="cv-auto" style="position:relative;max-width:1180px;margin:0 auto;padding:44px 24px 56px">
  <h2 style="margin:0 0 30px;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(40px,7vw,80px);letter-spacing:-.03em;line-height:.85;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">OUR PARTNERS</h2>
  <div style="font-family:'Shrikhand',serif;font-size:clamp(16px,2.4vw,22px);color:var(--r6);transform:rotate(2.2deg);margin:-22px 0 28px;display:inline-block">with a little help from</div>
  
  <div style="display:flex;flex-direction:column;gap:20px">
    <!-- Title Sponsors -->
    <div style="background:var(--card);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:20px">
      <div style="display:flex;align-items:center;gap:12px;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:16px">
        ◆ Title Sponsors<span style="height:2px;flex:1;background:var(--line)"></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px">
        <div>
          <div style="font-family:inherit;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin-bottom:8px">Title Sponsor</div>
          <div style="background:var(--wcard);border:2px solid var(--ink);height:110px;display:grid;place-items:center">
            <img src="/assets/psg-logo.webp" alt="Title Sponsor" width="160" height="70" loading="lazy" decoding="async" style="max-height:70px;width:auto" />
          </div>
        </div>
        <div>
          <div style="font-family:inherit;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin-bottom:8px">Title Co-Sponsor</div>
          <div style="background:var(--wcard);border:2px solid var(--ink);height:110px;display:grid;place-items:center">
            <img src="/assets/csa-logo.webp" alt="Title Co-Sponsor" width="140" height="60" loading="lazy" decoding="async" style="max-height:60px;width:auto" />
          </div>
        </div>
      </div>
    </div>

    <!-- Event Sponsors -->
    <div style="background:var(--card);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:20px">
      <div style="display:flex;align-items:center;gap:12px;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:16px">
        ◆ Event Sponsors<span style="height:2px;flex:1;background:var(--line)"></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px">
        <div>
          <div style="font-family:inherit;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin-bottom:8px">Event Sponsor</div>
          <div style="background:var(--wcard);border:2px solid var(--ink);height:88px;display:grid;place-items:center">
            <img src="/assets/logo-brc.webp" alt="Event Sponsor" width="100" height="50" loading="lazy" decoding="async" style="max-height:50px;width:auto" />
          </div>
        </div>
        <div>
          <div style="font-family:inherit;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin-bottom:8px">Event Co-Sponsor</div>
          <div style="background:var(--wcard);border:2px solid var(--ink);height:88px;display:grid;place-items:center">
            <img src="/assets/logo-dq.webp" alt="Event Co-Sponsor" width="100" height="50" loading="lazy" decoding="async" style="max-height:50px;width:auto" />
          </div>
        </div>
      </div>
    </div>

    <!-- Partners -->
    <div style="background:var(--card);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:20px">
      <div style="display:flex;align-items:center;gap:12px;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:16px">
        ◆ Partners<span style="height:2px;flex:1;background:var(--line)"></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px">
        <div style="background:var(--wcard);border:2px solid var(--ink);height:76px;display:grid;place-items:center"><img src="/assets/logo-qz.webp" alt="Partner 1" width="50" height="40" loading="lazy" decoding="async" style="max-height:40px;width:auto" /></div>
        <div style="background:var(--wcard);border:2px solid var(--ink);height:76px;display:grid;place-items:center"><img src="/assets/logo-mm.webp" alt="Partner 2" width="50" height="40" loading="lazy" decoding="async" style="max-height:40px;width:auto" /></div>
        <div style="background:var(--wcard);border:2px solid var(--ink);height:76px;display:grid;place-items:center"><img src="/assets/logo-svc.webp" alt="Partner 3" width="50" height="40" loading="lazy" decoding="async" style="max-height:40px;width:auto" /></div>
        <div style="background:var(--wcard);border:2px solid var(--ink);height:76px;display:grid;place-items:center"><img src="/assets/logo-val.webp" alt="Partner 4" width="50" height="40" loading="lazy" decoding="async" style="max-height:40px;width:auto" /></div>
      </div>
    </div>

    <!-- Alumni Sponsors -->
    <div style="background:var(--card);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:20px">
      <div style="display:flex;align-items:center;gap:12px;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:6px">
        ◆ Alumni Sponsors<span style="height:2px;flex:1;background:var(--line)"></span>
      </div>
      <div style="font-size:13px;color:var(--ink2);margin-bottom:14px">With gratitude to the graduates who keep the lights on.</div>
      <div style="column-width:230px;column-gap:28px">
        <div style="display:flex;align-items:baseline;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);break-inside:avoid"><span style="color:var(--acc);font-size:10px">◆</span><span style="font-size:14.5px;font-weight:600;color:var(--ink)">A. Ramanathan</span><span style="font-family:inherit;font-size:11px;color:var(--ink2);margin-left:auto">'02</span></div>
        <div style="display:flex;align-items:baseline;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);break-inside:avoid"><span style="color:var(--acc);font-size:10px">◆</span><span style="font-size:14.5px;font-weight:600;color:var(--ink)">Priya Chandran</span><span style="font-family:inherit;font-size:11px;color:var(--ink2);margin-left:auto">'05</span></div>
        <div style="display:flex;align-items:baseline;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);break-inside:avoid"><span style="color:var(--acc);font-size:10px">◆</span><span style="font-size:14.5px;font-weight:600;color:var(--ink)">K. Vignesh</span><span style="font-family:inherit;font-size:11px;color:var(--ink2);margin-left:auto">'11</span></div>
        <div style="display:flex;align-items:baseline;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);break-inside:avoid"><span style="color:var(--acc);font-size:10px">◆</span><span style="font-size:14.5px;font-weight:600;color:var(--ink)">S. Harini</span><span style="font-family:inherit;font-size:11px;color:var(--ink2);margin-left:auto">'16</span></div>
      </div>
    </div>
  </div>
</section>
