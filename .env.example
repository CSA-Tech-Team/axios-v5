# Copy to .env and adjust. Values here are defaults/placeholders only.

# ACHRONOS — Beyond Time intro (once per session, enabled by default).
# Set false to omit the intro. Repeat visits and reduced-motion preferences
# do not download Three.js. PUBLIC_WARP_INTRO remains a legacy fallback.
PUBLIC_ACHRONOS_INTRO=true

# Cloudflare deploy credentials — real values live in .env, never commit them.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
