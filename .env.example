# Copy to .env and adjust. Values here are defaults/placeholders only.

# Landing animation (hyperspace warp intro on first load).
#   true  -> intro plays
#   false / anything else / unset -> intro is skipped
# Skipping also keeps three.js out of the client bundle.
PUBLIC_WARP_INTRO=false

# Cloudflare deploy credentials — real values live in .env, never commit them.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
