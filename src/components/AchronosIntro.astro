---
interface Props {
  duration?: number;
  alwaysReplay?: boolean;
}
const { duration = 5.1, alwaysReplay = false } = Astro.props;
---

<div
  id="achronos-intro"
  hidden
  role="dialog"
  tabindex="-1"
  aria-modal="true"
  aria-label="AXIOS: ACHRONOS — Beyond Time"
  data-duration={duration}
  data-always-replay={alwaysReplay ? '1' : '0'}
>
  <canvas class="achronos-canvas" aria-hidden="true"></canvas>
  <div class="achronos-grain" aria-hidden="true"></div>
  <div class="achronos-top">
    <button class="achronos-skip" type="button">Skip intro <span aria-hidden="true">↗</span></button>
  </div>
  <div class="achronos-caption" aria-hidden="true">
    <p class="achronos-kicker">A convergence of eras</p>
    <p class="achronos-title">ACHRONOS</p>
    <p class="achronos-subtitle"><span></span>Beyond Time<span></span></p>
  </div>
  <div class="achronos-bottom" aria-hidden="true">
    <div class="achronos-eras"><span>Past</span><span>Present</span><span>Future</span></div>
    <div class="achronos-track"><span></span></div>
    <p>What was. What is. What will be.</p>
  </div>
  <img class="achronos-static" src="/assets/logo26.webp" width="920" height="842" alt="" />
</div>

<!-- Decide before the first paint; without JavaScript the page stays accessible. -->
<script is:inline>
  (() => {
    const host = document.getElementById('achronos-intro');
    if (!host) return;
    let seen = false;
    try { seen = sessionStorage.getItem('axios_achronos_intro_v1') === '1'; } catch {}
    if ((seen && host.dataset.alwaysReplay !== '1') || location.hash) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    host.dataset.state = reduced ? 'static' : 'loading';
    host.hidden = false;
    document.documentElement.classList.add('achronos-active');
    // This fallback is independent of module loading, WebGL and session storage.
    host._fallback = setTimeout(() => {
      host.dispatchEvent(new Event('achronos:abort'));
      host.hidden = true;
      document.documentElement.classList.remove('achronos-active');
    }, reduced ? 450 : 12000);
    host.querySelector('button').onclick = () => {
      host.dispatchEvent(new Event('achronos:abort'));
      host.hidden = true;
      document.documentElement.classList.remove('achronos-active');
      clearTimeout(host._fallback);
      try { sessionStorage.setItem('axios_achronos_intro_v1', '1'); } catch {}
    };
  })();
</script>

<script>
  import { startAchronosIntro } from '../scripts/achronos-intro.js';
  const host = document.getElementById('achronos-intro');
  if (host && !host.hidden) startAchronosIntro(host);
</script>

<style>
  #achronos-intro {
    --intro-ink: #f7f1e4;
    --intro-muted: #b4a793;
    position: fixed;
    inset: 0;
    z-index: 10000;
    overflow: hidden;
    background: #15110e;
    color: var(--intro-ink);
    font-family: 'Jost', sans-serif;
    isolation: isolate;
    outline: none;
    touch-action: none;
  }
  #achronos-intro[hidden] { display: none; }
  .achronos-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .achronos-grain {
    position: absolute; inset: 0; pointer-events: none; opacity: .16;
    background-image: radial-gradient(#bbaa88 .6px, transparent .8px);
    background-size: 3px 3px;
    mask-image: radial-gradient(ellipse, #0003, #000);
  }
  .achronos-top {
    position: absolute; inset: max(24px, env(safe-area-inset-top)) clamp(24px, 4vw, 64px) auto;
    display: flex; align-items: center; justify-content: flex-end;
  }
  .achronos-skip {
    display: flex; align-items: center; justify-content: center; gap: 16px;
    min-height: 44px; padding: 6px 0 6px 14px; border: 0; background: transparent;
    color: inherit; font: inherit; font-size: 12px; letter-spacing: .09em; cursor: pointer;
  }
  .achronos-skip span { font-size: 21px; }
  .achronos-skip:focus-visible { outline: 1px solid currentColor; outline-offset: 6px; }
  .achronos-caption { position: absolute; top: 70%; left: 16px; right: 16px; text-align: center; }
  .achronos-caption p { margin: 0; }
  .achronos-kicker { color: var(--intro-muted); font-size: 10px; letter-spacing: .28em; text-transform: uppercase; }
  .achronos-title { font-family: 'Anton', sans-serif; font-size: clamp(38px, 5.2vw, 66px); line-height: 1.25; letter-spacing: .12em; padding-left: .12em; }
  .achronos-subtitle { display: flex; align-items: center; justify-content: center; gap: 14px; font-size: 11px; letter-spacing: .32em; text-transform: uppercase; }
  .achronos-subtitle span { width: 24px; height: 1px; background: currentColor; opacity: .5; }
  .achronos-bottom { position: absolute; bottom: max(24px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: min(360px, calc(100% - 64px)); }
  .achronos-eras { display: flex; justify-content: space-between; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
  .achronos-eras span { opacity: .38; }
  .achronos-track { height: 1px; background: #f7f1e42b; margin-top: 10px; }
  .achronos-track span { display: block; width: 100%; height: 1px; background: #d7aa63; transform: scaleX(0); transform-origin: left; }
  .achronos-bottom p { margin: 12px 0 0; text-align: center; font-size: 10px; letter-spacing: .06em; color: var(--intro-muted); }
  .achronos-static { display: none; }
  #achronos-intro[data-state='static'] .achronos-static {
    display: block; position: absolute; width: min(44vw, 250px); height: auto;
    left: 50%; top: 40%; transform: translate(-50%, -50%); filter: brightness(0) invert(1);
  }
  #achronos-intro[data-state='static'] :is(.achronos-canvas, .achronos-grain, .achronos-bottom) { display: none; }
  :global(html.achronos-active), :global(html.achronos-active body) { overflow: hidden; }
  @media (max-width: 600px) {
    .achronos-caption { top: 68%; }
    .achronos-title { font-size: clamp(34px, 9.5vw, 48px); }
    .achronos-top { top: max(16px, env(safe-area-inset-top)); }
  }
  @media (max-height: 600px) {
    .achronos-caption { top: 66%; }
    .achronos-kicker, .achronos-bottom p { display: none; }
    .achronos-title { font-size: 30px; }
    .achronos-subtitle { font-size: 9px; }
    .achronos-bottom { bottom: 16px; }
    .achronos-top { top: 10px; }
  }
</style>
