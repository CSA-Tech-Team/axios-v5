        </div>
      </div>
    </div>

    <!-- Q4 -->
    <div class="faq-card" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 7px 0 rgba(36,26,18,.22);padding:18px 20px;transform:rotate(1.2deg);display:grid;grid-template-columns:7fr 3fr;gap:16px;transition:transform .18s">
      <div style="padding-right:16px;border-right:2px dashed var(--line)">
        <div style="font-weight:700;font-size:16px;line-height:1.25;display:flex;gap:9px;align-items:flex-start"><span style="color:var(--acc)">?</span>What should I bring?</div>
        <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:var(--ink2)">A laptop with a charger, your college ID, and the registration QR from your confirmation email. Wi-Fi and power strips are provided at every station.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
          <span style="position:relative;width:52px;height:44px;flex:none;display:grid;place-items:center;border:2px dashed var(--ink);background:var(--r4);transform:rotate(3deg)"><span style="font-family:'Anton',sans-serif;font-size:15px;color:#fff;line-height:1">AX</span><span style="position:absolute;bottom:2px;right:3px;font-size:7px;font-weight:700;color:#fff;letter-spacing:.06em">'26</span></span>
          <span style="width:58px;height:58px;flex:none;border:1.5px solid var(--ink);border-radius:50%;box-shadow:inset 0 0 0 3px var(--wcard),inset 0 0 0 4.5px var(--ink);display:grid;place-items:center;text-align:center;transform:rotate(-13deg);opacity:.5;margin-left:28px;margin-top:-12px">
            <span style="font-size:7.5px;font-weight:800;letter-spacing:.08em;line-height:1.35;color:var(--ink)">AXIOS<br>11 SEP<br>PSG</span>
