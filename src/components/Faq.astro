    <!-- Q5 -->
    <div class="faq-card" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 7px 0 rgba(36,26,18,.22);padding:18px 20px;transform:rotate(-1.4deg);display:grid;grid-template-columns:7fr 3fr;gap:16px;transition:transform .18s">
      <div style="padding-right:16px;border-right:2px dashed var(--line)">
        <div style="font-weight:700;font-size:16px;line-height:1.25;display:flex;gap:9px;align-items:flex-start"><span style="color:var(--acc)">?</span>Is accommodation available?</div>
        <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:var(--ink2)">Yes — limited hostel accommodation is available on request at a nominal charge. Flag it during registration or write to the contact below.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
