<section id="faq" class="cv-auto" style="position:relative;max-width:1180px;margin:0 auto;padding:56px 24px">
  <!-- Dangling Vintage Phone Graphic -->
  <span style="position:absolute;top:130px;left:-14px;z-index:2;pointer-events:none;display:block;width:clamp(50px,4.6vw,66px);transform-origin:50% 0;animation:dangle 5.2s ease-in-out infinite">
    <span style="position:absolute;top:-6px;left:50%;transform:translateX(-50%) rotate(-7deg);width:74px;height:20px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:2"></span>
    <img 
      src="/assets/tele-cut.webp" 
      alt="Dangling telephone" 
      width="66" 
      height="66" 
      loading="lazy" 
      decoding="async" 
      style="display:block;width:100%;height:auto;filter:drop-shadow(3px 4px 0 rgba(36,26,18,.22))" 
    />
  </span>

  <h2 style="margin:0 0 30px;text-align:right;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(40px,7vw,80px);letter-spacing:-.03em;line-height:.85;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">HELP &amp; FAQ</h2>
  
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:26px 24px">
    <!-- Q1 -->
    <div class="faq-card" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 7px 0 rgba(36,26,18,.22);padding:18px 20px;transform:rotate(-1.1deg);display:grid;grid-template-columns:7fr 3fr;gap:16px;transition:transform .18s">
      <div style="padding-right:16px;border-right:2px dashed var(--line)">
        <div style="font-weight:700;font-size:16px;line-height:1.25;display:flex;gap:9px;align-items:flex-start"><span style="color:var(--acc)">?</span>Who can participate in Axios?</div>
        <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:var(--ink2)">Any undergraduate or postgraduate student from any college can register. You do not need to be from a computing branch — the events reward clear thinking as much as technical skill.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
          <span style="position:relative;width:52px;height:44px;flex:none;display:grid;place-items:center;border:2px dashed var(--ink);background:var(--r1);transform:rotate(3deg)"><span style="font-family:'Anton',sans-serif;font-size:15px;color:#fff;line-height:1">AX</span><span style="position:absolute;bottom:2px;right:3px;font-size:7px;font-weight:700;color:#fff;letter-spacing:.06em">'26</span></span>
          <span style="width:58px;height:58px;flex:none;border:1.5px solid var(--ink);border-radius:50%;box-shadow:inset 0 0 0 3px var(--wcard),inset 0 0 0 4.5px var(--ink);display:grid;place-items:center;text-align:center;transform:rotate(-13deg);opacity:.5;margin-left:28px;margin-top:-12px">
            <span style="font-size:7.5px;font-weight:800;letter-spacing:.08em;line-height:1.35;color:var(--ink)">AXIOS<br>11 SEP<br>PSG</span>
          </span>
        </div>
        <div style="display:flex;flex-direction:column;gap:9px;margin-top:2px">
          <span style="font-size:8px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink2)">To the curious</span>
          <span style="height:1.5px;background:var(--line)"></span>
          <span style="height:1.5px;background:var(--line)"></span>
          <span style="height:1.5px;background:var(--line);width:72%"></span>
        </div>
      </div>
    </div>

    <!-- Q2 -->
    <div class="faq-card" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 7px 0 rgba(36,26,18,.22);padding:18px 20px;transform:rotate(0.9deg);display:grid;grid-template-columns:7fr 3fr;gap:16px;transition:transform .18s">
      <div style="padding-right:16px;border-right:2px dashed var(--line)">
        <div style="font-weight:700;font-size:16px;line-height:1.25;display:flex;gap:9px;align-items:flex-start"><span style="color:var(--acc)">?</span>Do I need to be an expert coder?</div>
        <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:var(--ink2)">No. Only Breach Point and the Triathlon build round assume coding comfort. DataQuest, the Quiz and Math Mania are open to anyone who enjoys problem-solving — beginners regularly place well.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
