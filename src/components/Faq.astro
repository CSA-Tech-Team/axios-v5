          <span style="height:1.5px;background:var(--line)"></span>
          <span style="height:1.5px;background:var(--line);width:72%"></span>
        </div>
      </div>
    </div>

    <!-- Q3 -->
    <div class="faq-card" style="position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 7px 0 rgba(36,26,18,.22);padding:18px 20px;transform:rotate(-0.7deg);display:grid;grid-template-columns:7fr 3fr;gap:16px;transition:transform .18s">
      <div style="padding-right:16px;border-right:2px dashed var(--line)">
        <div style="font-weight:700;font-size:16px;line-height:1.25;display:flex;gap:9px;align-items:flex-start"><span style="color:var(--acc)">?</span>Can I register solo, or need a team?</div>
        <p style="margin:10px 0 0;font-size:14.5px;line-height:1.55;color:var(--ink2)">Both work. A Delegate pass lets you enter every individual event alone; a Team of Five is best for the relay. You can also form teams on-site during boot-up.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px">
        <div style="display:flex;flex-direction:column;align-items:flex-start;gap:2px">
