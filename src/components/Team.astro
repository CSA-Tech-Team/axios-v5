---
import { siteConfig } from '../config/site.config';
const { team } = siteConfig;

// Per-card decorative styling (rotation, sticky-tape rotation) — presentational
// only, kept in the component and zipped with content data by index.
const cardStyle = [
  { rotate: 'rotate(1.1deg)', tapeRotate: 'rotate(-4deg)' },
  { rotate: 'rotate(-1deg)', tapeRotate: 'rotate(5deg)' },
  { rotate: 'rotate(1.4deg)', tapeRotate: 'rotate(-3deg)' },
  { rotate: 'rotate(-1.2deg)', tapeRotate: 'rotate(4deg)' },
  { rotate: 'rotate(-1.4deg)', tapeRotate: 'rotate(3deg)' },
];
---

<section id="team" class="cv-auto" style="position:relative;max-width:1180px;margin:0 auto;padding:56px 24px">
  <span style="position:absolute;top:22px;right:20px;color:var(--acc);opacity:.45;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="0" x2="12" y2="24"></line><line x1="0" y1="12" x2="24" y2="12"></line></svg>
  </span>
  <span style="position:absolute;bottom:22px;left:20px;color:var(--r5);opacity:.45;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="0" x2="12" y2="24"></line><line x1="0" y1="12" x2="24" y2="12"></line></svg>
  </span>
  <img 
    src="/assets/camera-hand.webp" 
    alt="Camera hand illustration" 
    width="164" 
    height="164" 
    loading="lazy" 
    decoding="async"
    style="position:absolute;top:14px;right:34px;z-index:1;width:clamp(100px,13vw,164px);height:auto;pointer-events:none;transform:rotate(7deg);mix-blend-mode:multiply" 
  />

  <h2 style="margin:0 0 30px;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(48px,9vw,112px);line-height:.82;letter-spacing:-.03em;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">MEET THE TEAM</h2>
  
  <div class="team-groups">
    {team.map((group, gi) => (
      <div>
        <div class:list={['team-section-heading', gi % 2 === 0 ? 'team-section-heading-a' : 'team-section-heading-b']}>
          <h3>{group.title}</h3>
          <i></i>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:22px">
          {group.members.map((member, i) => {
            // Offset by group so the second wall does not repeat the first's tilts.
            const s = cardStyle[(i + gi) % cardStyle.length];
            return (
              <div class="tcard" style={`position:relative;background:var(--wcard);border:2px solid var(--ink);box-shadow:6px 6px 0 var(--ink);padding:12px 12px 18px;transform:${s.rotate};transition:transform .3s,box-shadow .3s`}>
                <div style={`position:absolute;top:-11px;left:50%;transform:translateX(-50%) ${s.tapeRotate};width:88px;height:22px;background:rgba(240,165,0,.5);border:1px dashed rgba(0,0,0,.22);z-index:4`}></div>
                <span style="position:relative;display:block">
                  <img
                    src={member.photo}
                    alt={`${member.role} - ${member.name}`}
                    width="200"
                    height="184"
                    loading="lazy"
                    decoding="async"
                    style="display:block;width:100%;height:184px;object-fit:cover"
                  />
                  <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.09"></span>
                </span>
                <div style="font-family:'Shrikhand',serif;font-size:15px;color:var(--acc);margin-top:12px">{member.role}</div>
                <div style="font-family:'Bricolage Grotesque',system-ui,sans-serif;font-weight:800;letter-spacing:-.02em;font-size:clamp(20px,3.2vw,28px);line-height:1;color:var(--ink);margin-top:2px;text-shadow:0 1px 0 #fbf5e8,2px 0 0 rgba(226,59,46,.4),-2px 1px 0 rgba(47,143,208,.34)">{member.name}</div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .team-groups {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  /* Same treatment as the technical / non-technical event headings. */
  .team-section-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 22px;
    font-family: 'Shrikhand', serif;
    font-size: clamp(20px, 3vw, 28px);
  }

  .team-section-heading h3 {
    display: inline-block;
    margin: 0;
    font: inherit;
    font-weight: 400;
  }

  .team-section-heading i {
    height: 2px;
    flex: 1;
    background: var(--line);
  }

  .team-section-heading-a {
    color: var(--acc);
  }

  .team-section-heading-a h3 {
    transform: rotate(1.2deg);
  }

  .team-section-heading-b {
    color: var(--r5);
  }

  .team-section-heading-b h3 {
    transform: rotate(-1.4deg);
  }

  @media (max-width: 720px) {
    .team-groups { gap: 36px; }
  }
</style>
