---
---

<section id="board" class="cv-auto" style="position:relative;padding:56px 0 60px;overflow:hidden;border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);background:var(--paper)">
  <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:minmax(280px,.85fr) 1.15fr;gap:44px;align-items:start">
    <!-- Left Column: Copy & Stats -->
    <div>
      <div style="display:inline-block;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:var(--ink);color:var(--paper);padding:5px 10px;transform:rotate(-1.5deg);margin-bottom:14px">Third edition · 2026</div>
      <h2 style="margin:0;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(40px,6.4vw,74px);line-height:.84;letter-spacing:-.03em;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">AXIOS<br>IS BACK</h2>
      <p style="margin:20px 0 0;font-size:16px;line-height:1.55;color:var(--ink2);max-width:38ch;text-wrap:pretty">The loudest technical fest on campus is back for its third edition! Two days of arenas that bring in students from all over Coimbatore and outside, making this a true spectacle.</p>
      <p style="margin:14px 0 0;font-size:16px;line-height:1.55;color:var(--ink2);max-width:38ch;text-wrap:pretty">This year runs bigger: eight events, a signature triathlon, and a ₹1,50,000 pool. Here's what the last two looked like.</p>
      <div style="display:flex;gap:26px;margin-top:26px;flex-wrap:wrap">
        <div>
          <div style="font-family:'Anton',sans-serif;font-size:40px;line-height:.9;color:var(--r1)">3,200+</div>
          <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);margin-top:4px">Past participants</div>
        </div>
        <div>
          <div style="font-family:'Anton',sans-serif;font-size:40px;line-height:.9;color:var(--acc2)">40+</div>
          <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink2);margin-top:4px">Colleges represented</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Polaroid Grid -->
    <div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px 20px;align-items:start">
        <!-- Photo 1: Edition I -->
        <div style="background:var(--wcard);padding:9px 9px 28px;border:1px solid #0002;box-shadow:5px 7px 0 rgba(36,26,18,.18);transform:rotate(-2.2deg)">
          <span style="position:relative;display:block">
            <img 
              src="/assets/court-statue.webp" 
              alt="Axios Edition I Highlights" 
              width="400" 
              height="210" 
              loading="lazy" 
              decoding="async" 
              style="display:block;width:100%;height:210px;object-fit:cover" 
            />
            <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.11"></span>
            <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.08"></span>
          </span>
          <div style="font-family:'Shrikhand',serif;font-size:13px;color:var(--r5);text-align:center;margin-top:8px">edition i · '24</div>
        </div>

        <div style="display:grid;gap:18px;align-content:start;margin-top:26px">
          <!-- Photo 2 -->
          <div style="background:var(--wcard);padding:9px 9px 9px;border:1px solid #0002;box-shadow:5px 7px 0 rgba(36,26,18,.18);transform:rotate(1.8deg)">
            <span style="position:relative;display:block">
              <img 
                src="/assets/eye-crop.webp" 
                alt="Axios Tech Challenge" 
                width="400" 
                height="150" 
                loading="lazy" 
                decoding="async" 
                style="display:block;width:100%;height:150px;object-fit:cover" 
              />
              <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.11"></span>
              <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.08"></span>
            </span>
          </div>
          <!-- Sticker Badge -->
          <div style="background:var(--acc);color:#fff;padding:18px 16px;border:2px solid var(--ink);box-shadow:4px 5px 0 var(--ink);transform:rotate(-1.2deg);text-align:center">
            <div style="font-family:'Anton',sans-serif;font-size:26px;line-height:.95;letter-spacing:.02em">SAME CHAOS.<br>BIGGER STAKES.</div>
          </div>
        </div>

        <!-- Photo 3 -->
        <div style="background:var(--wcard);padding:9px 9px 9px;border:1px solid #0002;box-shadow:5px 7px 0 rgba(36,26,18,.18);transform:rotate(2.4deg)">
          <span style="position:relative;display:block">
            <img 
              src="/assets/lens-cut.webp" 
              alt="Axios Event Crowd" 
              width="400" 
              height="170" 
              loading="lazy" 
              decoding="async" 
              style="display:block;width:100%;height:170px;object-fit:cover" 
            />
            <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.11"></span>
            <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.08"></span>
          </span>
        </div>

        <!-- Photo 4: Edition II -->
        <div style="background:var(--wcard);padding:9px 9px 28px;border:1px solid #0002;box-shadow:5px 7px 0 rgba(36,26,18,.18);transform:rotate(-1.6deg)">
          <span style="position:relative;display:block">
            <img 
              src="/assets/thinker-halftone.webp" 
              alt="Axios Edition II Highlights" 
              width="400" 
              height="196" 
              loading="lazy" 
              decoding="async" 
              style="display:block;width:100%;height:196px;object-fit:cover" 
            />
            <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;background:radial-gradient(circle,#241a12 30%,transparent 32%);background-size:3.2px 3.2px;opacity:.11"></span>
            <span style="position:absolute;inset:0;pointer-events:none;mix-blend-mode:soft-light;background:var(--acc);opacity:.08"></span>
          </span>
          <div style="font-family:'Shrikhand',serif;font-size:13px;color:var(--acc2);text-align:center;margin-top:8px">edition ii · '25</div>
        </div>
      </div>

      <div style="font-family:'Shrikhand',serif;font-size:19px;color:var(--r5);transform:rotate(2.6deg);margin-top:22px;text-align:right">you had to be there ✦</div>
    </div>
  </div>
</section>
