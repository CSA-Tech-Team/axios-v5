---
import { siteConfig } from '../config/site.config';
const { hero, event } = siteConfig;
---

<section id="welcome" style="position:relative;border-bottom:2px solid var(--ink);overflow:hidden;height:100vh;min-height:660px;display:flex;align-items:center">
  <!-- Decorative Hands -->
  <img 
    src="/assets/human-hand2.webp" 
    alt="Human hand illustration" 
    width="440" 
    height="440" 
    loading="eager" 
    decoding="async"
    style="position:absolute;left:0;bottom:58%;width:clamp(240px,27vw,440px);height:auto;transform:rotate(3deg);mix-blend-mode:multiply;pointer-events:none;z-index:1" 
  />
  <img 
    src="/assets/robot-hand5.webp" 
    alt="Robot hand illustration" 
    width="440" 
    height="440" 
    loading="eager" 
    decoding="async"
    style="position:absolute;right:0;top:49%;width:clamp(240px,27vw,440px);height:auto;transform:rotate(-4deg);mix-blend-mode:multiply;pointer-events:none;z-index:1" 
  />

  <span style="position:absolute;top:18px;right:20px;color:var(--r5);opacity:.55;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="0" x2="12" y2="24"></line>
      <line x1="0" y1="12" x2="24" y2="12"></line>
    </svg>
  </span>

  <div style="position:relative;z-index:2;max-width:1320px;width:100%;margin:0 auto;padding:34px 24px;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:clamp(12px,2.1vh,30px)">
    <!-- SEO: descriptive H1 for crawlers/screen readers; the visual title is the AXIOS wordmark image below -->
    <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">
      {event.name} '26 — {event.symposiumType} by {event.organizer.name} at {event.date.venueName}, {event.date.venueCity}
    </h1>

    <!-- Subtitle Header -->
    <div style="display:flex;align-items:center;gap:16px;justify-content:center">
      <span style="height:2px;flex:1;max-width:200px;background:var(--ink)"></span>
      <p style="font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);margin:0">{hero.eyebrow}</p>
      <span style="height:2px;flex:1;max-width:200px;background:var(--ink)"></span>
    </div>

    <!-- Volume Tag -->
    <div style="display:inline-flex;align-self:center;border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink)">
      <span style="background:var(--ink);color:var(--acc2);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:7px 15px">{event.symposiumType}</span>
      <span style="background:var(--card);color:var(--ink);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:7px 15px;border-left:3px solid var(--ink)">{event.volumeLabel}</span>
    </div>

    <!-- AXIOS '26 Logo -->
    <div id="axis-word" role="img" aria-label="Axios '26 Logo" style="position:relative;display:block;margin:0 auto;width:min(clamp(280px,46vw,620px),52vh);aspect-ratio:920/842">
      <img
        src="/assets/logo26.webp"
        alt="Axios '26"
        width="920"
        height="842"
        fetchpriority="high"
        decoding="async"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;transform:translate(var(--px,0px),var(--py,0px));filter:drop-shadow(6px 7px 0 rgba(36,26,18,.16))"
      />
    </div>

    <!-- Tagline -->
    <span class="hero-tagline" style="align-self:center;margin-top:-4px;display:inline-flex;align-items:center;gap:14px;white-space:nowrap;max-width:100%;background:var(--paper);padding:6px 18px;font-family:'Jost','Futura',sans-serif;font-size:clamp(12px,1.5vw,19px);font-weight:600;line-height:1;letter-spacing:.32em;text-transform:uppercase;color:var(--ink);animation:passIn .01s steps(1) 1.35s both;pointer-events:none">
      <span style="color:var(--acc);font-size:.8em;letter-spacing:0">✦</span>
      {hero.taglineQuote}
      <span style="color:var(--acc);font-size:.8em;letter-spacing:0">✦</span>
    </span>

    <!-- Event Date & Add to Calendar -->
    <div style="margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 24px;font-family:'Anton',sans-serif;color:var(--ink)">
      <a
        href={`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(`${event.name} '26 · ${event.symposiumType}`)}&dates=${event.date.calendarStart}/${event.date.calendarEnd}&details=${encodeURIComponent(`${event.name} ${event.symposiumType} — ${event.organizer.shortName}`)}&location=${encodeURIComponent(event.date.venueName + ', ' + event.date.venueCity)}`}
        target="_blank"
        rel="noopener" 
        title="Save the date, add to Google Calendar"
        style="display:inline-block;margin-right:2px;cursor:pointer;transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px) rotate(2deg)'"
        onmouseout="this.style.transform='none'"
      >
        <img 
          src="/assets/floppy-cut.webp" 
          alt="Add Axios '26 to Google Calendar" 
          width="90" 
          height="90" 
          loading="eager"
          decoding="async"
          style="display:block;width:clamp(56px,6.8vw,90px);height:auto;transform:rotate(-9deg);filter:drop-shadow(4px 5px 0 rgba(36,26,18,.26))" 
        />
      </a>
      <span style="font-size:clamp(26px,4.5vw,52px);transform:rotate(-1deg)">{event.date.label}</span>
      <span style="color:var(--acc);font-size:clamp(16px,2.6vw,26px);transform:rotate(12deg)">✶</span>
      <span style="font-size:clamp(26px,4.5vw,52px);transform:rotate(.8deg)">{event.date.venueShort}</span>
    </div>

    <!-- CTA Buttons -->
    <div style="margin:0;display:flex;flex-wrap:wrap;gap:16px;justify-content:center">
      <a 
        href="#register" 
        data-go="register" 
        style="display:inline-flex;align-items:center;gap:9px;background:var(--acc);color:#fff;font-size:16px;font-weight:700;padding:14px 26px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px)'"
        onmouseout="this.style.transform='none'"
      >
        {hero.registerCta}
      </a>
      <a
        href="#events"
        data-go="events"
        style="display:inline-flex;align-items:center;gap:9px;background:var(--card);color:var(--ink);font-size:16px;font-weight:700;padding:14px 26px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px)'"
        onmouseout="this.style.transform='none'"
      >
        {hero.lineupCta}
      </a>
    </div>
  </div>
</section>

<style>
  /* The tagline is set in wide tracking on one line; below ~700px that line is
     wider than the viewport, so it is allowed to wrap and the tracking eases. */
  @media (max-width: 700px) {
    .hero-tagline {
      white-space: normal !important;
      text-align: center;
      text-wrap: balance;
      gap: 10px !important;
      padding: 6px 10px !important;
      letter-spacing: .2em !important;
      line-height: 1.45 !important;
    }
  }

  @media (max-width: 420px) {
    .hero-tagline {
      letter-spacing: .14em !important;
      font-size: 11px !important;
    }
  }
</style>

<script>
  function initHeroParallax() {
    const word = document.getElementById('axis-word');
    if (!word) return;
    let mx = 0, my = 0, raf: number | null = null;

    function paint() {
      raf = null;
      const r = word!.getBoundingClientRect();
      if (r.bottom < 0 || r.top > window.innerHeight) return;
      const cx = (mx - r.left - r.width / 2) / r.width;
      const cy = (my - r.top - r.height / 2) / r.height;
      word!.style.setProperty('--px', (cx * 3).toFixed(2) + 'px');
      word!.style.setProperty('--py', (cy * 2.5).toFixed(2) + 'px');
    }

    window.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
      if (!raf) raf = requestAnimationFrame(paint);
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initHeroParallax);
</script>
