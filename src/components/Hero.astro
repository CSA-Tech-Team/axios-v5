---
import { siteConfig } from '../config/site.config';
const { hero, event } = siteConfig;
---

<section id="welcome" style="position:relative;border-bottom:2px solid var(--ink);overflow:hidden;height:calc(100svh - var(--nav-height, 56px));min-height:min(660px,calc(100svh - var(--nav-height, 56px)));display:flex;align-items:center">
  <!-- Decorative Hands -->
  <img 
    src="/assets/human-hand2.webp" 
    alt="Human hand illustration" 
    data-hero-depth="8"
    width="440" 
    height="440" 
    loading="eager" 
    decoding="async"
    style="position:absolute;left:0;bottom:58%;width:clamp(240px,27vw,440px);height:auto;transform:rotate(3deg);mix-blend-mode:multiply;pointer-events:none;z-index:1" 
  />
  <img 
    src="/assets/robot-hand5.webp" 
    alt="Robot hand illustration" 
    data-hero-depth="10"
    width="440" 
    height="440" 
    loading="eager" 
    decoding="async"
    style="position:absolute;right:0;top:49%;width:clamp(240px,27vw,440px);height:auto;transform:rotate(-4deg);mix-blend-mode:multiply;pointer-events:none;z-index:1" 
  />

  <span data-hero-depth="12" style="position:absolute;top:18px;right:20px;color:var(--r5);opacity:.55;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="0" x2="12" y2="24"></line>
      <line x1="0" y1="12" x2="24" y2="12"></line>
    </svg>
  </span>

  <div class="hero-content" style="position:relative;z-index:2;max-width:1320px;width:100%;margin:0 auto;padding:34px 24px;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:var(--hero-gap)">
    <!-- SEO: descriptive H1 for crawlers/screen readers; the visual title is the AXIOS wordmark image below -->
    <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">
      {event.name} '26 — {event.symposiumType} by {event.organizer.name} at {event.date.venueName}, {event.date.venueCity}
    </h1>

    <!-- Subtitle Header -->
    <div class="hero-credit" data-hero-depth="3" style="display:flex;align-items:center;gap:16px;justify-content:center">
      <span style="height:2px;flex:1;max-width:200px;background:var(--ink)"></span>
      <p style="font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);margin:0">{hero.eyebrow}</p>
      <span style="height:2px;flex:1;max-width:200px;background:var(--ink)"></span>
    </div>

    <!-- Volume Tag -->
    <div data-hero-depth="5" style="display:inline-flex;align-self:center;border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink)">
      <span style="background:var(--ink);color:var(--acc2);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:7px 15px">{event.symposiumType}</span>
      <span style="background:var(--card);color:var(--ink);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:7px 15px;border-left:3px solid var(--ink)">{event.volumeLabel}</span>
    </div>

    <!-- AXIOS '26 Logo -->
    <div id="axis-word" role="img" aria-label="Axios '26 Logo" style="position:relative;display:block;margin:0 auto;width:min(clamp(280px,46vw,620px),52vh);aspect-ratio:920/842">
      <img
        src="/assets/logo26.webp"
        alt="Axios '26"
        data-hero-depth="14"
        width="920"
        height="842"
        fetchpriority="high"
        decoding="async"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;filter:drop-shadow(6px 7px 0 rgba(36,26,18,.16))"
      />
    </div>

    <!-- Tagline -->
    <span class="hero-tagline" data-hero-depth="4" style="align-self:center;margin-top:-4px;display:inline-flex;align-items:center;gap:14px;white-space:nowrap;max-width:100%;background:var(--paper);padding:6px 18px;font-family:'Jost','Futura',sans-serif;font-size:clamp(12px,1.5vw,19px);font-weight:600;line-height:1;letter-spacing:.32em;text-transform:uppercase;color:var(--ink);animation:passIn .01s steps(1) 1.35s both;pointer-events:none">
      <span style="color:var(--acc);font-size:.8em;letter-spacing:0">✦</span>
      {hero.taglineQuote}
      <span style="color:var(--acc);font-size:.8em;letter-spacing:0">✦</span>
    </span>

    <!-- Event Date & Add to Calendar -->
    <div class="hero-date-row" style="margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 24px;font-family:'Anton',sans-serif;color:var(--ink)">
      <a
        href={`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(`${event.name} '26 · ${event.symposiumType}`)}&dates=${event.date.calendarStart}/${event.date.calendarEnd}&details=${encodeURIComponent(`${event.name} ${event.symposiumType} — ${event.organizer.shortName}`)}&location=${encodeURIComponent(event.date.venueName + ', ' + event.date.venueCity)}`}
        target="_blank"
        rel="noopener" 
        title="Save the date, add to Google Calendar"
        data-hero-depth="10"
        style="display:inline-block;margin-right:2px;cursor:pointer;transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px) rotate(2deg)'"
        onmouseout="this.style.transform='none'"
      >
        <img 
          src="/assets/floppy-cut.webp" 
          alt="Add Axios '26 to Google Calendar" 
          width="90" 
          height="90" 
          loading="eager"
          decoding="async"
          style="display:block;width:clamp(56px,6.8vw,90px);height:auto;transform:rotate(-9deg);filter:drop-shadow(4px 5px 0 rgba(36,26,18,.26))" 
        />
      </a>
      <span data-hero-depth="6" style="font-size:clamp(22px,3.8vw,44px);transform:rotate(-1deg)">{event.date.label}</span>
      <span data-hero-depth="8" style="color:var(--acc);font-size:clamp(14px,2.3vw,22px);transform:rotate(12deg)">✶</span>
      <span data-hero-depth="5" style="font-size:clamp(22px,3.8vw,44px);transform:rotate(.8deg)">{event.date.venueShort}</span>
    </div>

    <!-- CTA Buttons -->
    <div style="margin:0;display:flex;flex-wrap:wrap;gap:16px;justify-content:center">
      <a
        href={event.registrationUrl}
        data-hero-depth="2"
        target="_blank"
        rel="noopener noreferrer"
        style="display:inline-flex;align-items:center;gap:9px;background:var(--acc);color:#fff;font-size:16px;font-weight:700;padding:14px 26px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px)'"
        onmouseout="this.style.transform='none'"
      >
        {hero.registerCta}
      </a>
      <a
        href="#events"
        data-go="events"
        data-hero-depth="2.5"
        style="display:inline-flex;align-items:center;gap:9px;background:var(--card);color:var(--ink);font-size:16px;font-weight:700;padding:14px 26px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px)'"
        onmouseout="this.style.transform='none'"
      >
        {hero.lineupCta}
      </a>
    </div>
  </div>
</section>

<style>
  [data-hero-depth] {
    translate: var(--hero-shift-x, 0px) var(--hero-shift-y, 0px);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-hero-depth] { translate: none; }
  }
  /* The tagline is set in wide tracking on one line; below ~700px that line is
     wider than the viewport, so it is allowed to wrap and the tracking eases. */
  @media (max-width: 700px) {
    .hero-tagline {
      white-space: normal !important;
      text-align: center;
      text-wrap: balance;
      gap: 10px !important;
      padding: 6px 10px !important;
      letter-spacing: .2em !important;
      line-height: 1.45 !important;
    }
  }

  @media (max-width: 420px) {
    .hero-tagline {
      letter-spacing: .14em !important;
      font-size: 11px !important;
    }
  }

  .hero-content { --hero-gap: clamp(12px, 2.1vh, 24px); }
  .hero-tagline { margin-top: 0 !important; }

  /* Keep both calls to action inside the first viewport on compact phones. */
  @media (max-height: 620px) {
    .hero-content {
      padding: 10px 16px !important;
      --hero-gap: 6px;
    }

    .hero-content > div:nth-last-child(2) {
      gap: 4px 14px !important;
    }

    .hero-content > div:nth-last-child(2) > span {
      font-size: 22px !important;
    }

    .hero-tagline {
      margin-top: 0 !important;
      padding: 4px 9px !important;
      font-size: 10px !important;
      line-height: 1.25 !important;
      letter-spacing: .14em !important;
    }

    .hero-content > div:last-child { gap: 10px !important; }

    .hero-content > div:last-child a {
      padding: 10px 18px !important;
      font-size: 14px !important;
    }
  }

  @media (max-width: 360px) and (max-height: 620px) {
    .hero-content { transform: translateY(-12px); }

    .hero-content > div:last-child {
      flex-wrap: nowrap !important;
      gap: 8px !important;
    }

    .hero-content > div:last-child a {
      padding: 9px 10px !important;
      font-size: 13px !important;
      white-space: nowrap;
    }
  }
</style>

<script>
  function initHeroParallax() {
    const element = document.getElementById('welcome');
    if (!element) return;
    const hero = element;
    const layers = [...hero.querySelectorAll<HTMLElement>('[data-hero-depth]')].map(el => ({
      el, depth: Number(el.dataset.heroDepth), x: 0, y: 0
    }));
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const pointer = matchMedia('(hover: hover) and (pointer: fine)');
    const controller = new AbortController();
    const options = { passive: true, signal: controller.signal };
    let px = 0, py = 0, scroll = 0, raf = 0, last = 0;
    let visible = true;
    const blocked = () => reduced.matches || document.hidden || !visible || document.documentElement.classList.contains('achronos-active');
    const stop = () => { cancelAnimationFrame(raf); raf = 0; last = 0; };
    const reset = () => {
      stop();
      layers.forEach(layer => {
        layer.x = layer.y = 0;
        layer.el.style.removeProperty('--hero-shift-x');
        layer.el.style.removeProperty('--hero-shift-y');
      });
    };
    function frame(now: number) {
      raf = 0;
      if (blocked()) { last = 0; return; }
      const dt = last ? Math.min((now - last) / 1000, .05) : 1 / 60;
      last = now;
      let moving = false;
      layers.forEach(layer => {
        const targetX = px * layer.depth;
        const targetY = (py * .45 - scroll * .85) * layer.depth;
        const follow = 1 - Math.exp(-dt * (8 + layer.depth * .12));
        layer.x += (targetX - layer.x) * follow;
        layer.y += (targetY - layer.y) * follow;
        const unsettled = Math.abs(targetX - layer.x) + Math.abs(targetY - layer.y) > .02;
        if (!unsettled) { layer.x = targetX; layer.y = targetY; }
        moving ||= unsettled;
        layer.el.style.setProperty('--hero-shift-x', `${layer.x.toFixed(2)}px`);
        layer.el.style.setProperty('--hero-shift-y', `${layer.y.toFixed(2)}px`);
      });
      if (moving) raf = requestAnimationFrame(frame);
      else last = 0;
    }
    function wake() { if (!raf && !blocked()) raf = requestAnimationFrame(frame); }
    function updateScroll() {
      const rect = hero.getBoundingClientRect();
      scroll = Math.max(0, Math.min(1, (window.scrollY) / Math.max(1, rect.height)));
      wake();
    }
    const releasePointer = () => { px = py = 0; wake(); };
    hero.addEventListener('pointermove', (event) => {
      if (!pointer.matches || event.pointerType === 'touch' || blocked()) return;
      const rect = hero.getBoundingClientRect();
      px = Math.max(-1, Math.min(1, (event.clientX - rect.left) / rect.width * 2 - 1));
      py = Math.max(-1, Math.min(1, (event.clientY - rect.top) / rect.height * 2 - 1));
      wake();
    }, options);
    hero.addEventListener('pointerleave', releasePointer, options);
    hero.addEventListener('pointercancel', releasePointer, options);
    // Keep keyboard targets still and let touch devices use scroll depth only.
    hero.addEventListener('focusin', releasePointer, options);
    window.addEventListener('scroll', updateScroll, options);
    window.addEventListener('resize', updateScroll, options);
    window.addEventListener('blur', releasePointer, options);
    pointer.addEventListener('change', releasePointer, options);
    reduced.addEventListener('change', () => { px = py = 0; reset(); updateScroll(); }, options);
    document.addEventListener('visibilitychange', () => { stop(); updateScroll(); }, options);
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) updateScroll(); else stop();
    });
    observer.observe(hero);
    const cleanup = () => { reset(); observer.disconnect(); controller.abort(); };
    window.addEventListener('pagehide', cleanup, options);
    document.addEventListener('astro:before-swap', cleanup, options);
    updateScroll();
  }

  document.addEventListener('DOMContentLoaded', initHeroParallax);
</script>
