---
---

<section id="welcome" style="position:relative;border-bottom:2px solid var(--ink);overflow:hidden;height:100vh;min-height:660px;display:flex;align-items:center">
  <!-- Decorative Hands -->
  <img 
    src="/assets/human-hand2.webp" 
    alt="Human hand illustration" 
    width="440" 
    height="440" 
    loading="eager" 
    decoding="async"
    style="position:absolute;left:0;bottom:58%;width:clamp(240px,27vw,440px);height:auto;transform:rotate(3deg);mix-blend-mode:multiply;pointer-events:none;z-index:1" 
  />
  <img 
    src="/assets/robot-hand5.webp" 
    alt="Robot hand illustration" 
    width="440" 
    height="440" 
    loading="eager" 
    decoding="async"
    style="position:absolute;right:0;top:49%;width:clamp(240px,27vw,440px);height:auto;transform:rotate(-4deg);mix-blend-mode:multiply;pointer-events:none;z-index:1" 
  />

  <!-- Top Institutions Header Badges -->
  <span style="position:absolute;top:16px;left:22px;display:inline-flex;align-items:center;gap:14px">
    <img 
      src="/assets/psg-logo.webp" 
      alt="PSG College of Technology" 
      width="62" 
      height="62" 
      fetchpriority="high"
      decoding="async"
      style="height:clamp(44px,5vw,62px);width:auto;mix-blend-mode:multiply" 
    />
    <span style="width:1.5px;height:36px;background:var(--ink);opacity:.35"></span>
    <img 
      src="/assets/csa-logo.webp" 
      alt="Computational Sciences Association" 
      width="44" 
      height="44" 
      fetchpriority="high"
      decoding="async"
      style="height:clamp(30px,3.6vw,44px);width:auto;mix-blend-mode:multiply" 
    />
  </span>

  <span style="position:absolute;top:18px;right:20px;color:var(--r5);opacity:.55;pointer-events:none">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="12" cy="12" r="5"></circle>
      <line x1="12" y1="0" x2="12" y2="24"></line>
      <line x1="0" y1="12" x2="24" y2="12"></line>
    </svg>
  </span>

  <div style="max-width:1320px;width:100%;margin:0 auto;padding:34px 24px;text-align:center;display:flex;flex-direction:column;justify-content:center;gap:clamp(20px,3.6vh,48px)">
    <!-- Subtitle Header -->
    <div style="display:flex;align-items:center;gap:16px;justify-content:center">
      <span style="height:2px;flex:1;max-width:200px;background:var(--ink)"></span>
      <h1 style="font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);margin:0">Computational Sciences Association presents</h1>
      <span style="height:2px;flex:1;max-width:200px;background:var(--ink)"></span>
    </div>

    <!-- Volume Tag -->
    <div style="display:inline-flex;align-self:center;border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink)">
      <span style="background:var(--ink);color:var(--acc2);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:7px 15px">Technical Symposium</span>
      <span style="background:var(--card);color:var(--ink);font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;padding:7px 15px;border-left:3px solid var(--ink)">Vol. III · MMXXVI</span>
    </div>

    <!-- 3D Multi-layered AXIOS Logo Wordmark -->
    <div id="axis-word" role="img" aria-label="Axios '26 Logo" style="position:relative;display:block;margin:0 auto;width:clamp(220px,56vw,680px);aspect-ratio:871/230;font-size:clamp(70px,17vw,240px);line-height:.84">
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--r6);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;transform:translate(clamp(0em, calc(.028em + var(--px,0px)* 6), 15.0px),clamp(0em, calc(.028em + var(--py,0px)* 6), 15.0px));animation:passIn .01s steps(1) 0.15s both;pointer-events:none"></span>
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--r5);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;transform:translate(clamp(0em, calc(.023em + var(--px,0px)* 5), 12.5px),clamp(0em, calc(.023em + var(--py,0px)* 5), 12.5px));animation:passIn .01s steps(1) 0.3s both;pointer-events:none"></span>
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--r4);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;transform:translate(clamp(0em, calc(.018em + var(--px,0px)* 4), 10.0px),clamp(0em, calc(.018em + var(--py,0px)* 4), 10.0px));animation:passIn .01s steps(1) 0.45s both;pointer-events:none"></span>
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--r3);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;transform:translate(clamp(0em, calc(.013em + var(--px,0px)* 3), 7.5px),clamp(0em, calc(.013em + var(--py,0px)* 3), 7.5px));animation:passIn .01s steps(1) 0.6s both;pointer-events:none"></span>
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--r2);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;transform:translate(clamp(0em, calc(.008em + var(--px,0px)* 2), 5.0px),clamp(0em, calc(.008em + var(--py,0px)* 2), 5.0px));animation:passIn .01s steps(1) 0.75s both;pointer-events:none"></span>
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--r1);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;transform:translate(clamp(0em, calc(.004em + var(--px,0px)* 1), 2.5px),clamp(0em, calc(.004em + var(--py,0px)* 1), 2.5px));animation:passIn .01s steps(1) 0.9s both;pointer-events:none"></span>
      <span aria-hidden="true" style="position:absolute;inset:0;background:var(--ink);-webkit-mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;mask:url(/assets/axios-logo-text.webp) center/contain no-repeat;animation:passIn .01s steps(1) 1.05s both;pointer-events:none"></span>
    </div>

    <!-- Tagline -->
    <span style="align-self:center;margin-top:-4px;display:inline-flex;align-items:center;gap:14px;white-space:nowrap;background:var(--paper);padding:6px 18px;font-family:'Jost','Futura',sans-serif;font-size:clamp(12px,1.5vw,19px);font-weight:600;line-height:1;letter-spacing:.32em;text-transform:uppercase;color:var(--ink);animation:passIn .01s steps(1) 1.35s both;pointer-events:none">
      <span style="color:var(--acc);font-size:.8em;letter-spacing:0">✦</span>
      where excellence awaits the worthy
      <span style="color:var(--acc);font-size:.8em;letter-spacing:0">✦</span>
    </span>

    <!-- Event Date & Add to Calendar -->
    <div style="margin:0 auto;display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 24px;font-family:'Anton',sans-serif;color:var(--ink)">
      <a 
        href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Axios%20%2726%20%C2%B7%20Technical%20Symposium&dates=20260911/20260913&details=Axios%20Technical%20Symposium%20%E2%80%94%20Computational%20Sciences%20Association&location=PSG%20College%20of%20Technology%2C%20Coimbatore" 
        target="_blank" 
        rel="noopener" 
        title="Save the date — add to Google Calendar" 
        style="display:inline-block;margin-right:2px;cursor:pointer;transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px) rotate(2deg)'"
        onmouseout="this.style.transform='none'"
      >
        <img 
          src="/assets/floppy-cut.webp" 
          alt="Add Axios '26 to Google Calendar" 
          width="90" 
          height="90" 
          loading="eager"
          decoding="async"
          style="display:block;width:clamp(56px,6.8vw,90px);height:auto;transform:rotate(-9deg);filter:drop-shadow(4px 5px 0 rgba(36,26,18,.26))" 
        />
      </a>
      <span style="font-size:clamp(26px,4.5vw,52px);transform:rotate(-1deg)">11–12 SEP '26</span>
      <span style="color:var(--acc);font-size:clamp(16px,2.6vw,26px);transform:rotate(12deg)">✶</span>
      <span style="font-size:clamp(26px,4.5vw,52px);transform:rotate(.8deg)">PSG TECH</span>
    </div>

    <!-- CTA Buttons -->
    <div style="margin:0;display:flex;flex-wrap:wrap;gap:16px;justify-content:center">
      <a 
        href="#register" 
        data-go="register" 
        style="display:inline-flex;align-items:center;gap:9px;background:var(--acc);color:#fff;font-size:16px;font-weight:700;padding:14px 26px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px)'"
        onmouseout="this.style.transform='none'"
      >
        ▶ Register Now
      </a>
      <a 
        href="#events" 
        data-go="events" 
        style="display:inline-flex;align-items:center;gap:9px;background:var(--card);color:var(--ink);font-size:16px;font-weight:700;padding:14px 26px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink);transition:transform .15s"
        onmouseover="this.style.transform='translate(-2px,-2px)'"
        onmouseout="this.style.transform='none'"
      >
        ✂ See the lineup
      </a>
    </div>
  </div>
</section>

<script>
  function initHeroParallax() {
    const word = document.getElementById('axis-word');
    if (!word) return;
    let mx = 0, my = 0, raf: number | null = null;

    function paint() {
      raf = null;
      const r = word.getBoundingClientRect();
      if (r.bottom < 0 || r.top > window.innerHeight) return;
      const cx = (mx - r.left - r.width / 2) / r.width;
      const cy = (my - r.top - r.height / 2) / r.height;
      word.style.setProperty('--px', (cx * 3).toFixed(2) + 'px');
      word.style.setProperty('--py', (cy * 2.5).toFixed(2) + 'px');
    }

    window.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
      if (!raf) raf = requestAnimationFrame(paint);
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initHeroParallax);
</script>
