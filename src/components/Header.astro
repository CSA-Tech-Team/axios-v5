---
---

<header style="position:sticky;top:0;z-index:1000;display:flex;align-items:center;gap:16px;height:52px;padding:0 22px;background:var(--term);color:var(--termfg);border-bottom:2px solid var(--ink);font-family:inherit">
  <div style="display:flex;align-items:center;gap:9px;font-size:14px;font-weight:700;letter-spacing:.04em">
    <span style="width:11px;height:11px;background:var(--acc);display:inline-block;transform:rotate(45deg)"></span>
    AXIOS <span style="color:#8a7a5c;font-weight:400">'26</span>
  </div>
  <nav class="topnav" style="display:flex;gap:2px;margin-left:6px;flex:1;overflow:hidden">
    <a href="#board" data-go="board" style="color:#c9b48c;font-size:12px;letter-spacing:.05em;text-transform:uppercase;padding:6px 9px">Legacy</a>
    <a href="#events" data-go="events" style="color:#c9b48c;font-size:12px;letter-spacing:.05em;text-transform:uppercase;padding:6px 9px">Lineup</a>
    <a href="#prizes" data-go="prizes" style="color:#c9b48c;font-size:12px;letter-spacing:.05em;text-transform:uppercase;padding:6px 9px">Prizes</a>
    <a href="#sponsors" data-go="sponsors" style="color:#c9b48c;font-size:12px;letter-spacing:.05em;text-transform:uppercase;padding:6px 9px">Sponsors</a>
    <a href="#faq" data-go="faq" style="color:#c9b48c;font-size:12px;letter-spacing:.05em;text-transform:uppercase;padding:6px 9px">Help</a>
  </nav>
  <span id="os-clock" style="min-width:82px;text-align:right;font-size:13px;letter-spacing:.02em">12:00 PM</span>
  <a href="#register" data-go="register" style="background:var(--acc);color:#fff;padding:7px 14px;font-size:12px;font-weight:700;letter-spacing:.04em;border:2px solid #fff2">▶ REGISTER</a>
</header>

<script>
  function setupHeader() {
    // Real-time Clock
    const clockEl = document.getElementById('os-clock');
    if (clockEl) {
      const updateClock = () => {
        const d = new Date();
        let h = d.getHours();
        const m = String(d.getMinutes()).padStart(2, '0');
        const ap = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        clockEl.textContent = `${h}:${m} ${ap}`;
      };
      updateClock();
      setInterval(updateClock, 1000);
    }

    // Scrollspy for nav links
    const links = Array.from(document.querySelectorAll('.topnav a[data-go]'));
    const ids = ['board', 'events', 'prizes', 'sponsors', 'faq'];
    
    if (links.length && 'IntersectionObserver' in window) {
      const setActive = (id: string) => {
        links.forEach((a) => {
          const el = a as HTMLElement;
          const on = el.getAttribute('data-go') === id;
          el.style.color = on ? '#f4b12a' : '#c9b48c';
          el.style.fontWeight = on ? '700' : '400';
        });
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && ids.includes(entry.target.id)) {
            setActive(entry.target.id);
          }
        });
      }, { rootMargin: '-45% 0px -50% 0px' });

      ids.forEach((id) => {
        const target = document.getElementById(id);
        if (target) observer.observe(target);
      });
    }

    // Smooth Scroll triggers
    document.querySelectorAll('[data-go]').forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = item.getAttribute('data-go');
        if (!targetId) return;
        const targetEl = document.getElementById(targetId);
        const header = document.querySelector('header');
        const headerH = header ? header.offsetHeight : 52;
        if (targetEl) {
          const y = targetEl.getBoundingClientRect().top + window.scrollY - headerH - 8;
          window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupHeader);
</script>
