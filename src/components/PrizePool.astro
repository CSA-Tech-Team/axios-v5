---
import { siteConfig } from '../config/site.config';
const { prizePool, event } = siteConfig;
---

<section id="prizes" style="position:relative;z-index:1;background:var(--teal-deep);border-bottom:2px solid var(--ink);color:#f3e7d3;padding:64px 0 72px;background-image:radial-gradient(rgba(255,255,255,.06) 1px,transparent 1px);background-size:22px 22px">
  <img
    class="prize-piggy"
    src="/assets/piggy-bank.webp"
    alt="Piggy bank illustration" 
    width="220" 
    height="220" 
    loading="lazy" 
    decoding="async" 
    style="position:absolute;top:26px;left:-36px;width:clamp(130px,16vw,220px);height:auto;transform:rotate(-10deg);filter:drop-shadow(5px 6px 0 rgba(0,0,0,.4));pointer-events:none" 
  />
  <img 
    src="/assets/dollar-bill.webp" 
    alt="Dollar bill illustration" 
    width="270" 
    height="160" 
    class="prize-bill"
    data-bill="1"
    loading="lazy" 
    decoding="async" 
    style="position:absolute;bottom:-62px;right:70px;z-index:3;opacity:0;width:clamp(160px,20vw,270px);height:auto;transform:rotate(12deg) scaleX(-1);filter:drop-shadow(5px 6px 0 rgba(0,0,0,.4));pointer-events:none" 
  />

  <div style="position:relative;max-width:1180px;margin:0 auto;padding:0 24px;text-align:center">
    <div class="prize-figure" style="position:relative;display:inline-block;margin-top:26px">
      <h2 style="margin:0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(72px,16vw,220px);line-height:.85;letter-spacing:.01em;color:#f3e7d3;transform:rotate(-1.5deg);text-shadow:4px 4px 0 var(--r1),8px 8px 0 var(--r2),12px 12px 0 var(--r3),16px 16px 0 rgba(0,0,0,.38)"><span style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">Axios '26 Prize Pool: </span>{prizePool.totalPrize}</h2>
      <div class="prize-callout" style="position:absolute;bottom:-30px;right:-26px;font-family:'Shrikhand',serif;font-size:clamp(17px,2.8vw,26px);color:var(--acc2);transform:rotate(3.5deg)">{prizePool.calloutText}</div>
    </div>
    <div class="prize-sub" style="margin:34px auto 0;max-width:36em;font-size:16px;line-height:1.6;color:#e6d7b8">{prizePool.subtext}</div>
    <div style="margin-top:30px">
      <a
        href={event.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        style="display:inline-flex;align-items:center;gap:9px;background:var(--acc);color:#fff;font-size:16px;font-weight:700;padding:14px 28px;border:3px solid #f3e7d3;box-shadow:6px 6px 0 rgba(243,231,211,.35)"
      >
        {prizePool.ctaLabel}
      </a>
    </div>
  </div>
</section>

<script>
  function initBillCrawl() {
    const bill = document.querySelector('[data-bill]');
    const prizesSection = document.getElementById('prizes');
    if (!bill || !prizesSection || !('IntersectionObserver' in window)) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = bill as HTMLElement;
          if (!el.style.animation) {
            el.style.animation = 'billCrawl 1.15s linear .25s both';
          }
        }
      });
    }, { threshold: 0.2 });

    observer.observe(prizesSection);
  }

  document.addEventListener('DOMContentLoaded', initBillCrawl);
</script>

<style>
  /* The piggy bank hangs off the left edge and the bill crawls in from past the
     right edge; below desktop the section clips them itself (sideways only, so
     the bill can still hang over the next section). */
  #prizes {
    overflow-x: clip;
  }
  /* Tablet: the callout's tuck past the figure's right edge is reserved as
     padding on the figure, so it stays inside its box. */
  @media (min-width: 481px) and (max-width: 1023px) {
    .prize-figure {
      padding-right: 26px;
    }
    .prize-callout {
      right: 0 !important;
    }
  }
  /* The callout is tucked past the right edge of the figure; on a phone the
     figure already fills the width, so it is pulled back inside. The piggy
     bank is shrunk into the top-left corner and the figure dropped below it,
     so the pig no longer sits behind the rupee sign. */
  @media (max-width: 480px) {
    .prize-piggy {
      width: 92px !important;
      top: 10px !important;
      left: -14px !important;
    }
    .prize-figure {
      margin-top: 44px !important;
    }
    .prize-callout {
      right: 0 !important;
      bottom: -26px !important;
    }
    .prize-sub {
      margin-top: 46px !important;
    }
    /* Smaller and further right, hanging less far, so the landed bill clears
       both the CTA above and the next section's heading below. */
    .prize-bill {
      width: 130px !important;
      right: 10px !important;
      bottom: -40px !important;
    }
  }
</style>
