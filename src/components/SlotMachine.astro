---
import { siteConfig } from '../config/site.config';

const { event, hero } = siteConfig;

// The reel faces are a classic slot vocabulary -- cherries, bells, BAR, 7s,
// money -- drawn entirely from type and inline SVG. Nothing here is shared
// with another section: the illustrations that used to spin (piggy bank,
// thinker, lens, eye, dollar bill, camera) all appear elsewhere on the page,
// so the machine read as a shelf of site assets rather than a slot machine.
type Face =
  | { svg: string }
  | { text: string; size: number; color: string; shadow?: string; bg?: string };

const cherriesSvg = `
<svg viewBox="0 0 100 100" width="84" height="84" aria-hidden="true" focusable="false">
  <g style="fill:none;stroke:var(--ink);stroke-width:5;stroke-linecap:round">
    <path d="M57 20C44 33 34 45 31 58" />
    <path d="M57 20C69 35 74 48 72 61" />
  </g>
  <path d="M57 20C66 5 83 4 93 11 84 24 67 29 57 20Z"
        style="fill:var(--r4);stroke:var(--ink);stroke-width:4;stroke-linejoin:round" />
  <circle cx="30" cy="72" r="19" style="fill:var(--acc);stroke:var(--ink);stroke-width:4" />
  <circle cx="71" cy="76" r="16" style="fill:var(--acc);stroke:var(--ink);stroke-width:4" />
  <circle cx="24" cy="66" r="4.5" style="fill:#fff;opacity:.85" />
  <circle cx="66" cy="71" r="3.5" style="fill:#fff;opacity:.8" />
</svg>`;

const bellSvg = `
<svg viewBox="0 0 100 100" width="78" height="78" aria-hidden="true" focusable="false">
  <circle cx="50" cy="19" r="7" style="fill:var(--acc2);stroke:var(--ink);stroke-width:4" />
  <path d="M25 70c0-27 8-43 25-43s25 16 25 43z"
        style="fill:var(--acc2);stroke:var(--ink);stroke-width:4;stroke-linejoin:round" />
  <rect x="15" y="69" width="70" height="11" style="fill:var(--acc2);stroke:var(--ink);stroke-width:4" />
  <circle cx="50" cy="89" r="7" style="fill:var(--ink)" />
</svg>`;

const FACES: Record<string, Face> = {
  free: { text: 'FREE', size: 60, color: 'var(--acc)', shadow: '3px 3px 0 var(--acc2)' },
  seven: { text: '7', size: 78, color: 'var(--acc)', shadow: '3px 3px 0 var(--ink)' },
  sevens: { text: '777', size: 42, color: 'var(--acc2)', shadow: '2px 2px 0 var(--ink)' },
  cash: { text: '$$$', size: 46, color: 'var(--r4)' },
  rupee: { text: '₹', size: 60, color: 'var(--r4)' },
  wild: { text: 'AX', size: 50, color: 'var(--r5)' },
  star: { text: '✶', size: 50, color: 'var(--acc2)' },
  bar: { text: 'BAR', size: 30, color: 'var(--card)', bg: 'var(--ink)' },
  cherries: { svg: cherriesSvg },
  bell: { svg: bellSvg },
};

// Each reel is 14 faces at 110px. The spin ends at translateY(-1240px), which
// centres index 12 in the 270px window, so FREE sits there on all three reels
// for the jackpot line. The resting offset centres index 1, giving a
// cherry-seven-cherry near miss before the lever is pulled.
const REELS: string[][] = [
  ['bar', 'cherries', 'seven', 'cash', 'bell', 'wild', 'rupee', 'sevens', 'cherries', 'star', 'bar', 'bell', 'free', 'cherries'],
  ['cherries', 'seven', 'bell', 'bar', 'cash', 'cherries', 'star', 'rupee', 'wild', 'sevens', 'cherries', 'bar', 'free', 'bell'],
  ['bell', 'cherries', 'bar', 'seven', 'cherries', 'cash', 'sevens', 'bell', 'rupee', 'wild', 'star', 'cherries', 'free', 'bar'],
];

const faceStyle = (f: Extract<Face, { text: string }>) =>
  `font-family:'Anton',sans-serif;line-height:1;font-size:${f.size}px;color:${f.color}` +
  (f.shadow ? `;text-shadow:${f.shadow}` : '') +
  (f.bg ? `;background:${f.bg};padding:7px 15px;letter-spacing:.06em` : '');
---

<section id="register" class="cv-auto" style="position:relative;background:var(--acc);color:#fff;padding:68px 0 70px">
  <!-- Scalloped Stamp Edge Top -->
  <div style="position:absolute;top:0;left:0;right:0;height:13px;background-image:radial-gradient(circle at 50% 0,var(--paper) 12px,transparent 12.5px);background-size:34px 26px;background-position:center top;background-repeat:repeat-x;pointer-events:none"></div>
  <!-- No scallop on the bottom edge: its cream circles leave the section's red
       showing between them, which read as a red line along the seam with the
       section below. The bottom is a clean straight cut instead. -->

  <div class="slot-wrap" style="max-width:1180px;margin:0 auto;padding:0 24px">
    <div class="slot-frame" style="display:inline-block;position:relative;margin:30px 74px 30px 0;transform:rotate(-1deg);max-width:calc(100% - 74px)">
      <!-- Hanger Clip Tab on top of frame -->
      <span class="slot-hanger" aria-hidden="true" style="position:absolute;left:50%;top:-30px;transform:translateX(-50%);display:block;width:36px;height:36px">
        <span style="position:absolute;left:50%;transform:translateX(-50%);top:0;width:24px;height:15px;background:var(--acc);border:3px solid var(--ink)"></span>
        <span style="position:absolute;left:50%;transform:translateX(-50%);top:14px;width:36px;height:22px;background:var(--acc2);border:3px solid var(--ink)"></span>
      </span>

      <!-- Cabinet Card Frame -->
      <div id="slot-cabinet" style="position:relative;background:var(--card);color:var(--ink);border:4px solid var(--ink);box-shadow:10px 10px 0 var(--ink);padding:16px 20px 18px">
        <!-- Frame Header -->
        <div class="slot-title" style="text-align:center;font-family:'Futura','Jost','Century Gothic',sans-serif;font-weight:900;font-size:clamp(28px,3.6vw,46px);letter-spacing:-.01em;line-height:.9;color:var(--ink);margin:2px 0 12px;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">
          GRAB YOUR PASS
        </div>

        <!-- 3 Reels Container -->
        <div class="slot-reels" style="position:relative;background:var(--ink);padding:12px;display:flex;gap:12px;justify-content:center">
          {REELS.map((strip, i) => (
            <span class="slot-reel" style="display:block;position:relative;width:clamp(108px,15vw,206px);height:270px;overflow:hidden;background:var(--wcard)">
              <span aria-hidden="true" style="position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(180deg,rgba(36,26,18,.5) 0%,rgba(36,26,18,.12) 18%,rgba(255,255,255,0) 34%,rgba(255,255,255,.42) 50%,rgba(255,255,255,0) 66%,rgba(36,26,18,.12) 82%,rgba(36,26,18,.5) 100%)"></span>
              <span id={`reel-${i + 1}`} style="display:block;transform:translateY(-30px)">
                {strip.map((key) => {
                  const face = FACES[key];
                  return (
                    <span class="slot-face" style="display:grid;place-items:center;height:110px">
                      {'svg' in face
                        ? <Fragment set:html={face.svg} />
                        : <span style={faceStyle(face)}>{face.text}</span>}
                    </span>
                  );
                })}
              </span>
            </span>
          ))}
        </div>

        <!-- Reel Result Footer Message -->
        <div class="slot-msgbox" style="margin:14px 8px 0;padding:6px 14px;text-align:center;font-family:'Shrikhand',serif;font-size:clamp(16px,2.3vw,24px);letter-spacing:.08em;line-height:1.15;color:var(--acc)">
          <span id="slot-msg" style="display:inline-block">pull the lever</span>
        </div>
      </div>

      <!-- Twinkle Sparkles around Cabinet -->
      <div id="slot-sparkles" style="display:none">
        <span class="spk1" aria-hidden="true" style="position:absolute;left:-22px;top:-26px;color:var(--acc);font-size:30px;pointer-events:none;animation:twk 1.3s ease-in-out infinite">✶</span>
        <span class="spk2" aria-hidden="true" style="position:absolute;right:26%;top:-34px;color:var(--acc2);font-size:24px;pointer-events:none;animation:twk 1.3s ease-in-out .35s infinite">✶</span>
        <span class="spk3" aria-hidden="true" style="position:absolute;right:-28px;top:60px;color:var(--r5);font-size:34px;pointer-events:none;animation:twk 1.3s ease-in-out .6s infinite">✶</span>
        <span class="spk4" aria-hidden="true" style="position:absolute;left:-28px;bottom:90px;color:var(--acc2);font-size:22px;pointer-events:none;animation:twk 1.3s ease-in-out .85s infinite">✶</span>
        <span class="spk5" aria-hidden="true" style="position:absolute;right:-16px;bottom:-16px;color:var(--acc);font-size:26px;pointer-events:none;animation:twk 1.3s ease-in-out 1.05s infinite">✶</span>
      </div>

      <!-- Lever Mechanism -->
      <span id="slot-lever-btn" class="slot-lever" title="Pull the lever!" style="position:absolute;right:-62px;top:24%;width:66px;height:230px;cursor:pointer;display:block">
        <span style="position:absolute;left:0;top:48px;width:24px;height:66px;background:var(--ink)"></span>
        <span style="position:absolute;left:22px;top:56px;width:11px;height:146px;background:var(--ink)"></span>
        <!-- The knob is the same accent as the section behind it, so the ball
             reads as a ball through its shading rather than its colour: a lit
             highlight up and left, a shaded terminator down and right. -->
        <span id="lever-knob" style="position:absolute;left:8px;top:30px;width:38px;height:38px;border-radius:50%;background:radial-gradient(circle at 34% 30%,rgba(255,255,255,.62),rgba(255,255,255,0) 46%),radial-gradient(circle at 70% 76%,rgba(36,26,18,.38),rgba(36,26,18,0) 54%),var(--acc);border:3px solid var(--ink);box-shadow:3px 3px 0 var(--ink);transition:top .24s cubic-bezier(.4,1.8,.5,1)"></span>
      </span>
    </div>

    <!-- The machine does the selling; this is the section's only call to
         action, and it opens the registration portal like every other CTA.
         The wrapper keeps it off the cabinet's line, which is inline-block. -->
    <div style="margin-top:8px">
      <a
        href={event.registrationUrl}
        target="_blank"
        rel="noopener noreferrer"
        style="display:inline-flex;align-items:center;gap:9px;background:var(--wcard);color:var(--acc);font-size:16px;font-weight:700;padding:14px 28px;border:3px solid var(--ink);box-shadow:6px 6px 0 var(--ink)"
      >
        {hero.registerCta}
      </a>
    </div>
  </div>
</section>

<style>
  /* On desktop the lever hangs outside the frame, which reserves margin for it.
     Below desktop the frame reserves that room as padding instead, so the lever
     sits inside the frame's own box and cannot spill past it. The cabinet keeps
     its size and place; the hanger and right-hand sparkles shift by the padding
     so they stay where they were relative to the cabinet. */
  @media (max-width: 1023px) {
    .slot-frame {
      box-sizing: border-box;
      padding-right: 62px;
      margin-right: 12px !important;
      max-width: calc(100% - 12px) !important;
    }

    .slot-lever { right: 0 !important; }
    .slot-hanger { left: calc(50% - 31px) !important; }
    .spk2 { right: calc(46px + 26%) !important; }
    .spk3 { right: 34px !important; }
    .spk5 { right: 46px !important; }
    /* The frame's tilt swings its lower-left corner outward, so this one
       sits a little further in than on desktop to stay on screen. */
    .spk4 { left: -14px !important; }
  }

  /* Phones: a slimmer lever, tighter cabinet padding and reel gutters so the
     three windows keep usable width, and faces scaled down (zoom on the face content only, so
     the 110px face pitch and the jackpot line are untouched). */
  @media (max-width: 560px) {
    .slot-wrap { padding: 0 16px !important; }

    .slot-frame {
      padding-right: 46px;
      margin-right: 8px !important;
      max-width: calc(100% - 8px) !important;
    }

    .slot-lever { width: 52px !important; }
    .slot-hanger { left: calc(50% - 23px) !important; }

    #slot-cabinet { padding: 14px 10px 14px !important; }
    .slot-title { font-size: min(28px, 7.2vw) !important; }
    .slot-reels { padding: 7px !important; gap: 7px !important; }
    .slot-face > :global(*) { zoom: .84; }
    .slot-msgbox { margin: 12px 0 0 !important; padding: 6px 2px !important; }
    /* The jackpot line wraps on phones; balance it so the star never sits
       alone on the second line. */
    #slot-msg { text-wrap: balance; }

    .spk1 { left: -10px !important; }
    .spk2 { right: calc(34px + 26%) !important; }
    .spk3 { right: 16px !important; top: 40px !important; }
    .spk4 { left: -2px !important; }
    .spk5 { right: 30px !important; }
  }

  @media (max-width: 400px) {
    .slot-face > :global(*) { zoom: .74; }
  }

  @media (max-width: 380px) {
    .slot-wrap { padding: 0 12px !important; }
    .slot-frame { margin-right: 6px !important; max-width: calc(100% - 6px) !important; }
    #slot-cabinet { padding: 12px 8px !important; }
    .slot-reels { padding: 5px !important; gap: 5px !important; }
    .slot-face > :global(*) { zoom: .7; }
    .slot-msgbox { font-size: 15px !important; }
  }

  @media (max-width: 340px) {
    .slot-face > :global(*) { zoom: .6; }
  }
</style>

<script>
  function initSlotMachine() {
    const leverBtn = document.getElementById('slot-lever-btn');
    const leverKnob = document.getElementById('lever-knob');
    const r1 = document.getElementById('reel-1');
    const r2 = document.getElementById('reel-2');
    const r3 = document.getElementById('reel-3');
    const msg = document.getElementById('slot-msg');
    const cabinet = document.getElementById('slot-cabinet');
    const sparkles = document.getElementById('slot-sparkles');
    let spinning = false;

    if (leverBtn && leverKnob && r1 && r2 && r3 && msg) {
      const pullLever = () => {
        if (spinning) return;
        spinning = true;

        if (sparkles) sparkles.style.display = 'none';

        // Lever knob pull animation
        leverKnob.style.top = '162px';
        setTimeout(() => { leverKnob.style.top = '30px'; }, 300);

        msg.textContent = 'spinning…';
        msg.style.animation = 'bl .45s steps(1) infinite';

        // Reel blur and spin reset
        [r1, r2, r3].forEach(r => {
          r.style.transition = 'none';
          r.style.transform = 'translateY(-30px)';
          r.style.filter = 'blur(2.5px)';
        });

        setTimeout(() => {
          r1.style.transition = 'transform 1.7s cubic-bezier(.25,.9,.3,1.14)';
          r1.style.transform = 'translateY(-1240px)';
        }, 80);

        setTimeout(() => {
          r2.style.transition = 'transform 2.2s cubic-bezier(.25,.9,.3,1.14)';
          r2.style.transform = 'translateY(-1240px)';
        }, 200);

        setTimeout(() => {
          r3.style.transition = 'transform 2.7s cubic-bezier(.25,.9,.3,1.14)';
          r3.style.transform = 'translateY(-1240px)';
        }, 320);

        // Completion & Jackpot
        setTimeout(() => {
          spinning = false;
          [r1, r2, r3].forEach(r => r.style.filter = 'blur(0px)');
          msg.style.animation = 'none';
          msg.textContent = 'jackpot! pass on the house ✶';
          if (cabinet) cabinet.style.animation = 'slotShake .45s steps(4) 1';
          if (sparkles) sparkles.style.display = 'block';
        }, 3000);
      };

      leverBtn.addEventListener('click', pullLever);
    }

  }

  document.addEventListener('DOMContentLoaded', initSlotMachine);
</script>
