---
import { siteConfig } from '../config/site.config';
import EventCard from './EventCard.astro';
import GameOverDeck from './GameOverDeck.astro';

const { events, lineup } = siteConfig;
const byKey = (key: string) => {
  const found = events.find((e) => e.key === key);
  if (!found) throw new Error(`Lineup.astro: no event configured with key "${key}"`);
  return found;
};
const posterName = (key: string) => {
  const ev = byKey(key);
  return (ev.posterLabel ?? ev.name).toUpperCase();
};

// Per-card decorative styling (rotation, accent shadow) — kept here since it is
// presentational, not content, and stays fixed regardless of copy edits.
const cardStyles: Record<string, { shadow: string; rotate: string; border?: string }> = {
  tri: { shadow: 'var(--ink)', rotate: 'rotate(-1deg)' },
  brc: { shadow: 'var(--acc)', rotate: 'rotate(.8deg) translateY(6px)' },
  dq: { shadow: 'var(--r3)', rotate: 'rotate(-.6deg)' },
  mm: { shadow: 'var(--r6)', rotate: 'rotate(-.9deg) translateY(4px)' },
  qz: { shadow: 'var(--r5)', rotate: 'rotate(1deg) translateY(-5px)' },
  svc: { shadow: 'var(--ink)', rotate: 'rotate(.7deg)', border: 'border:2px dashed var(--ink);' },
  // Big Bull's deep plate is shaded from the teal so it sits with it rather
  // than against it; otherwise it is a standard card.
  bb: { shadow: 'var(--teal-deep)', rotate: 'rotate(-.6deg)' },
  val: { shadow: 'var(--acc2)', rotate: 'rotate(-.8deg) translateY(5px)' },
  fifa: { shadow: 'var(--ink)', rotate: 'rotate(1.1deg) translateY(-3px)' },
  chess: { shadow: 'var(--teal)', rotate: 'rotate(-.5deg) translateY(2px)' },
};

const technicalEvents = ['tri', 'brc', 'dq', 'mm'].map(byKey);
// Big Bull sits in this row but renders through its own bespoke card treatment.
const nonTechnicalEvents = ['qz', 'svc', 'bb'].map(byKey);
// The Game Over events fill the next row, folded into one deck until dealt out.
const gamingEvents = ['val', 'fifa', 'chess'].map(byKey);
---

<section id="events" class="cv-auto" style="position:relative;z-index:2;max-width:1440px;margin:0 auto;padding:52px clamp(16px,2vw,24px)">
  <!-- Festival Poster Lineup: Gig-bill Paste-up -->
  <div class="event-name-wall" style="display:flex;flex-direction:column;align-items:center;gap:10px;max-width:1132px;margin:0 auto 8px">
    <div class="lineup-eyebrow" style="display:flex;align-items:center;justify-content:center;gap:14px;width:100%;max-width:760px;margin-bottom:10px">
      <span class="lineup-rule" style="height:2px;flex:1;background:var(--ink)"></span>
      <h2 style="margin:0;font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink);white-space:nowrap">{lineup.eyebrow}</h2>
      <span style="color:var(--acc);font-size:13px">✦</span>
      <span style="font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--ink2);white-space:nowrap">{lineup.arenaSummary}</span>
      <span class="lineup-rule" style="height:2px;flex:1;background:var(--ink)"></span>
    </div>

    <!-- Festival Poster Typography & Hover Previews -->
    <span class="qfactor-wall" style="position:relative;display:inline-block">
      <a
        href="#e-qz"
        data-open="qz"
        data-court-trigger="qf"
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(48px,10vw,120px);color:var(--ink);transform:skewX(-6deg) rotate(.6deg);text-shadow:5px 5px 0 var(--r5)"
        onmouseover="this.style.color='var(--r5)';this.style.textShadow='5px 5px 0 var(--ink)'"
        onmouseout="this.style.color='var(--ink)';this.style.textShadow='5px 5px 0 var(--r5)'"
      >
        {posterName('qz')}
      </a>
      <img
        src="/assets/thinker-halftone.webp"
        alt=""
        width="132"
        height="132"
        data-court="qf"
        loading="lazy"
        decoding="async"
        style="position:absolute;right:-118px;top:-58px;width:132px;height:auto;opacity:0;transform:rotate(6deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);mix-blend-mode:multiply;pointer-events:none"
      />
    </span>

    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:6px 26px">
      <span style="position:relative;display:inline-block">
        <a
          href="#e-brc"
          data-open="brc"
          data-court-trigger="brc"
          style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(34px,6.5vw,76px);color:transparent;-webkit-text-stroke:2.5px var(--acc);transform:rotate(1deg) translateY(2px)"
          onmouseover="this.style.webkitTextStrokeColor='var(--ink)'"
          onmouseout="this.style.webkitTextStrokeColor='var(--acc)'"
        >
          {posterName('brc')}
        </a>
        <img
          src="/assets/eye-crop.webp"
          alt=""
          width="150"
          height="150"
          data-court="brc"
          loading="lazy"
          decoding="async"
          style="position:absolute;left:-34px;top:-66px;width:150px;height:auto;opacity:0;transform:rotate(-4deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);border:1.5px solid var(--ink);box-shadow:4px 4px 0 rgba(36,26,18,.3);pointer-events:none"
        />
      </span>
      <span style="color:var(--acc2);font-size:clamp(18px,3vw,30px);transform:rotate(12deg)">✶</span>
      <span style="position:relative;display:inline-block">
        <a
          href="#e-dq"
          data-open="dq"
          data-court-trigger="dq"
          style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(34px,6.5vw,76px);color:var(--ink);text-shadow:3px 3px 0 var(--r3);transform:rotate(-.9deg)"
          onmouseover="this.style.color='var(--teal)'"
          onmouseout="this.style.color='var(--ink)'"
        >
          {posterName('dq')}
        </a>
        <img
          src="/assets/lens-cut.webp"
          alt=""
          width="126"
          height="126"
          data-court="dq"
          loading="lazy"
          decoding="async"
          style="position:absolute;right:-30px;top:-84px;width:126px;height:auto;opacity:0;transform:rotate(9deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);filter:drop-shadow(4px 5px 0 rgba(36,26,18,.24));pointer-events:none"
        />
      </span>
    </div>

    <span class="triathlon-wall" style="position:relative;display:inline-block;transform:rotate(-1.4deg)">
      <a
        href="#e-tri"
        data-open="tri"
        data-court-trigger="tri"
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(44px,9vw,110px);color:var(--ink);text-shadow:-4px 3px 0 var(--acc2)"
        onmouseover="this.style.color='var(--r1)'"
        onmouseout="this.style.color='var(--ink)'"
      >
        {posterName('tri')}
      </a>
      <span aria-hidden="true" class="tri-spark-l" style="position:absolute;left:-26px;top:-14px;font-size:clamp(20px,3.4vw,40px);color:var(--acc2);animation:twk 2.4s ease-in-out infinite;pointer-events:none">✦</span>
      <span aria-hidden="true" class="tri-spark-r" style="position:absolute;right:-20px;top:6px;font-size:clamp(16px,2.6vw,30px);color:var(--r1);animation:twk 2.4s ease-in-out .8s infinite;pointer-events:none">✦</span>
      <img src="/assets/triathlon-runner.webp" alt="" width="150" height="100" data-court="tri" loading="lazy" decoding="async" class="triathlon-preview" style="opacity:0;transform:translateY(-46%) rotate(-4deg) translateY(6px)" />
    </span>

    <div style="display:flex;flex-wrap:wrap;justify-content:center;align-items:baseline;gap:6px 26px">
      <a
        href="#e-mm"
        data-open="mm"
        class="lineup-name-size"
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;color:var(--r6);background:repeating-linear-gradient(-16deg,var(--r6) 0 5px,var(--r7) 5px 10px);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;transform:rotate(1.2deg)"
      >
        {posterName('mm')}
      </a>
      <span style="color:var(--acc);font-size:clamp(18px,3vw,30px);transform:rotate(-8deg)">✶</span>
      <span class="big-bull-wall">
        <a href="#e-bb" data-open="bb" data-court-trigger="bb" class="big-bull-wall-link" aria-label={`${byKey('bb').name} — stock market event details`}>
          <span class="big-bull-title lineup-name-size">{posterName('bb')}</span>
        </a>
        <img src="/assets/big-bull-duotone.webp" alt="" width="100" height="100" data-court="bb" loading="lazy" decoding="async" class="big-bull-preview" style="opacity:0;transform:rotate(7deg) translateY(6px)" />
      </span>
    </div>

    <span class="survivors-wall" style="position:relative;display:inline-block">
      <a
        href="#e-svc"
        data-open="svc"
        data-court-trigger="svc"
        style="font-family:'Anton',sans-serif;line-height:.85;display:inline-block;transition:color .15s;font-size:clamp(32px,6vw,70px);color:var(--paper);background:var(--ink);padding:2px 12px 5px;transform:rotate(-1deg) translateY(-3px)"
        onmouseover="this.style.color='var(--acc2)'"
        onmouseout="this.style.color='var(--paper)'"
      >
        {posterName('svc')}
      </a>
      <img
        src="/assets/court-statue-sm.webp"
        alt=""
        width="150"
        height="150"
        data-court="svc"
        loading="lazy"
        decoding="async"
        class="survivors-preview"
        style="opacity:0;transform:rotate(-11deg) translateY(6px)"
      />
    </span>

    <div class="gameover-row" style="display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:14px 22px;margin-top:2px">
      <span style="position:relative;font-family:'Shrikhand',serif;font-size:clamp(16px,2.6vw,26px);color:var(--r2);transform:rotate(-5deg);z-index:2">
        {lineup.gamingLeadIn}
      </span>
      <span class="gameover-wall" style="position:relative;display:inline-block">
        <span data-court-trigger="go" style="font-family:'Anton',sans-serif;font-size:clamp(44px,8.5vw,104px);line-height:.85;color:var(--r7);display:inline-block;transform:rotate(.8deg) skewX(-4deg);text-shadow:5px 5px 0 var(--ink)">{lineup.gamingHeading}</span>
        <img
          src="/assets/jett-crop.webp"
          alt=""
          width="115"
          height="115"
          data-court="go"
          loading="lazy"
          decoding="async"
          style="position:absolute;left:-46px;top:74px;width:115px;height:auto;opacity:0;transform:rotate(-6deg) translateY(6px);transition:opacity .12s steps(2),transform .18s steps(3);border:1.5px solid var(--ink);box-shadow:4px 4px 0 rgba(36,26,18,.3);pointer-events:none"
        />
      </span>
      <span style="display:flex;flex-direction:column;gap:10px">
        <a href="#e-val" data-open="val" style="font-family:inherit;font-size:clamp(13px,1.8vw,17px);font-weight:700;letter-spacing:.08em;color:var(--ink);background:var(--card);border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:7px 14px;transform:rotate(-3deg);transition:transform .15s">▸ {posterName('val')}</a>
        <a href="#e-fifa" data-open="fifa" style="font-family:inherit;font-size:clamp(13px,1.8vw,17px);font-weight:700;letter-spacing:.08em;color:var(--paper);background:var(--teal);border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:7px 14px;transform:rotate(2.5deg);transition:transform .15s">▸ {posterName('fifa')}</a>
        <a href="#e-chess" data-open="chess" style="font-family:inherit;font-size:clamp(13px,1.8vw,17px);font-weight:700;letter-spacing:.08em;color:var(--ink);background:var(--acc2);border:3px solid var(--ink);box-shadow:4px 4px 0 var(--ink);padding:7px 14px;transform:rotate(-1.5deg);transition:transform .15s">▸ {posterName('chess')}</a>
      </span>
    </div>
  </div>

  <div style="text-align:center;margin-top:18px">
    <span style="font-family:'Shrikhand',serif;font-size:clamp(14px,2vw,19px);color:var(--teal);display:inline-block;text-transform:none">{lineup.hint}</span>
  </div>

  <!-- Event Cards Grid -->
  <div class="event-card-container">
    <div class="event-section-heading event-section-heading-technical">
      <h3>{lineup.technicalHeading}</h3>
      <i></i>
    </div>

    <div class="event-cards-grid event-cards-grid-technical">
      {technicalEvents.map((ev) => (
        <EventCard event={ev} cardStyle={cardStyles[ev.key]} prizeLabel={lineup.prizeLabel} signatureBadge={lineup.signatureBadge} />
      ))}
    </div>

    <div class="event-section-heading event-section-heading-nontechnical">
      <h3>{lineup.nonTechnicalHeading}</h3>
      <i></i>
    </div>

    <div class="event-cards-grid event-cards-grid-nontechnical">
      {nonTechnicalEvents.map((ev) => (
        <EventCard event={ev} cardStyle={cardStyles[ev.key]} prizeLabel={lineup.prizeLabel} />
      ))}
      <GameOverDeck events={gamingEvents} cardStyles={cardStyles} prizeLabel={lineup.prizeLabel} />
    </div>
  </div>
</section>

<style>
  @keyframes eventWallDrop {
    0% {
      opacity: 0;
      translate: 0 -28px;
      filter: saturate(.6);
    }
    72% {
      opacity: 1;
      translate: 0 3px;
      filter: saturate(1);
    }
    100% {
      opacity: 1;
      translate: 0 0;
      filter: none;
    }
  }

  .event-name-wall.is-entering > * {
    opacity: 0;
    animation: eventWallDrop .62s cubic-bezier(.2,.85,.28,1.08) forwards;
    will-change: opacity, translate, filter;
  }

  .event-name-wall.is-entering > :nth-child(1) { animation-delay: .02s; }
  .event-name-wall.is-entering > :nth-child(2) { animation-delay: .09s; }
  .event-name-wall.is-entering > :nth-child(3) { animation-delay: .16s; }
  .event-name-wall.is-entering > :nth-child(4) { animation-delay: .23s; }
  .event-name-wall.is-entering > :nth-child(5) { animation-delay: .30s; }
  .event-name-wall.is-entering > :nth-child(6) { animation-delay: .37s; }
  .event-name-wall.is-entering > :nth-child(7) { animation-delay: .44s; }

  @media (prefers-reduced-motion: reduce) {
    .event-name-wall.is-entering > * {
      opacity: 1;
      animation: none;
      translate: none;
      filter: none;
    }
  }

  .triathlon-wall > a {
    position: relative;
    z-index: 2;
  }

  .triathlon-preview {
    position: absolute;
    left: calc(100% - 18px);
    top: 48%;
    z-index: 8;
    width: clamp(120px, 15vw, 150px);
    height: auto;
    border: 1.5px solid var(--ink);
    box-shadow: 4px 4px 0 rgb(36 26 18 / 30%);
    transition: opacity .12s steps(2), transform .18s steps(3);
    pointer-events: none;
  }

  .survivors-wall > a {
    position: relative;
    z-index: 2;
  }

  .survivors-preview {
    position: absolute;
    left: auto;
    right: calc(100% - 40px);
    top: -50px;
    z-index: 7;
    width: 150px;
    height: auto;
    mix-blend-mode: multiply;
    transition: opacity .12s steps(2), transform .18s steps(3);
    pointer-events: none;
  }

  /* The two labels cannot share a row with the rules on a narrow phone, so the
     row wraps and the rules drop out rather than forcing an overflow. */
  @media (max-width: 460px) {
    .lineup-eyebrow {
      flex-wrap: wrap;
      gap: 6px 10px;
    }

    .lineup-rule {
      display: none;
    }
  }

  .event-card-container {
    max-width: 1240px;
    margin: 34px auto 0;
    padding: 0 clamp(8px, 2vw, 28px) 18px;
  }

  .event-section-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 22px;
    font-family: 'Shrikhand', serif;
    font-size: clamp(20px, 3vw, 28px);
  }

  .event-section-heading h3 {
    display: inline-block;
    margin: 0;
    font: inherit;
    font-weight: 400;
  }

  .event-section-heading i {
    height: 2px;
    flex: 1;
    background: var(--line);
  }

  .event-section-heading-technical {
    color: var(--acc);
  }

  .event-section-heading-technical h3 {
    transform: rotate(1.2deg);
  }

  .event-section-heading-nontechnical {
    margin-top: 44px;
    color: var(--teal);
  }

  .event-section-heading-nontechnical h3 {
    transform: rotate(-1.4deg);
  }

  .event-cards-grid {
    display: grid;
    gap: 30px 26px;
    align-items: stretch;
  }

  .event-cards-grid > .ecard {
    min-width: 0;
    height: 100%;
    max-width: none;
    max-height: none;
  }

  .event-cards-grid-technical {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .event-cards-grid-nontechnical {
    max-width: 1000px;
    margin: 0 auto;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  /* The court previews are hover-only; on a touch screen a tap would leave one
     stuck open and the larger ones hang past a phone's edge, so they sit out. */
  @media (hover: none) and (max-width: 1023px) {
    [data-court] {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .event-cards-grid-technical,
    .event-cards-grid-nontechnical {
      max-width: none;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Room for the tilted corners, so no card pokes outside its grid. The
       deck is pulled back out and re-insets itself (see GameOverDeck). */
    .event-cards-grid {
      padding-inline: 6px;
    }

    .event-cards-grid-nontechnical > :global(.go-deck) {
      margin-inline: -6px;
    }

    /* The sparkles sit in padding rather than hanging off the name. */
    .triathlon-wall {
      padding-inline: 20px;
    }

    .tri-spark-l {
      left: -6px !important;
    }

    /* Inset far enough that the twinkle's scale stays inside the padding. */
    .tri-spark-r {
      right: 8px !important;
    }

    /* Room for the skew on the QFactor and Game Over headings. */
    .qfactor-wall,
    .gameover-wall {
      padding-inline: 6px;
    }
  }

  /* Two columns leave the last non-technical card alone on its row; it is
     centred under the pair above rather than left hanging in one column. */
  @media (min-width: 561px) and (max-width: 980px) {
    .event-cards-grid-nontechnical > :global(.ecard:nth-last-child(2):nth-child(odd)) {
      grid-column: 1 / -1;
      justify-self: center;
      width: calc((100% - 26px) / 2);
    }
  }

  @media (max-width: 560px) {
    .gameover-row {
      margin-top: -6px !important;
      gap: 8px 16px !important;
    }

    .triathlon-preview {
      left: calc(100% - 14px);
      width: 120px;
    }

    .survivors-preview {
      left: auto;
      right: calc(100% - 38px);
      top: -40px;
      width: 120px;
    }

    .event-cards-grid-technical,
    .event-cards-grid-nontechnical {
      grid-template-columns: 1fr;
    }

    .event-section-heading-nontechnical {
      margin-top: 36px;
    }

    /* Keeps the widest name, with its sparkle padding, inside a 320px screen;
       from about 352px up this is the 44px it already was. */
    .triathlon-wall > a {
      font-size: min(44px, 12.5vw) !important;
    }
  }
</style>

<script>
  function initEventWallDrop() {
    const wall = document.querySelector('.event-name-wall');
    if (!wall || !('IntersectionObserver' in window)) return;
    const reveal = () => wall.classList.add('is-entering');
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        reveal();
        observer.disconnect();
      }
    }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });
    observer.observe(wall);
  }

  function initCourtTriggers() {
    document.querySelectorAll('[data-court-trigger]').forEach((trigger) => {
      const targetId = trigger.getAttribute('data-court-trigger');
      const img = document.querySelector(`[data-court="${targetId}"]`) as HTMLElement;
      if (!img) return;
      const baseTransform = img.style.transform;

      const show = () => {
        img.style.opacity = '1';
        img.style.transform = baseTransform.replace('translateY(6px)', 'translateY(0)');
      };
      const hide = () => {
        img.style.opacity = '0';
        img.style.transform = baseTransform;
      };

      trigger.addEventListener('mouseenter', show);
      trigger.addEventListener('mouseleave', hide);
      trigger.addEventListener('focus', show);
      trigger.addEventListener('blur', hide);
    });
  }

  // Cards deal in one tick of the clock hand apart; the motion itself lives in
  // EventCard. Each card is watched on its own, so a phone's single column
  // deals as it scrolls rather than all at once below the fold.
  const DEAL_TICK = 90; // ms between cards landing in the same batch
  const PRIZE_TICKS = 8;
  const PRIZE_TICK_MS = 55;

  // The prize counts up from ₹0 like a score. Its width is pinned first so the
  // shorter interim figures do not shift the row, and the configured string is
  // restored verbatim at the end.
  function tickPrize(el: HTMLElement, startAfter: number) {
    const final = el.textContent ?? '';
    const target = Number(final.replace(/[^\d]/g, ''));
    if (!final.trim().startsWith('₹') || !target) return;
    el.style.minWidth = `${el.offsetWidth}px`;
    el.textContent = '₹0';
    let step = 0;
    const next = () => {
      step += 1;
      if (step >= PRIZE_TICKS) {
        el.textContent = final;
        return;
      }
      const value = Math.round((target * step) / PRIZE_TICKS / 100) * 100;
      el.textContent = `₹${value.toLocaleString('en-IN')}`;
      setTimeout(next, PRIZE_TICK_MS);
    };
    setTimeout(next, startAfter);
  }

  function initCardDeal() {
    if (!('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // The Game Over cover deals in like a card; the cards folded beneath it
    // deal too, landing in the deck.
    const cards = document.querySelectorAll<HTMLElement>('.event-cards-grid .ecard, .event-cards-grid .go-cover');
    cards.forEach((card) => { card.dataset.deal = 'pending'; });

    const deal = (card: HTMLElement, order: number) => {
      const delay = order * DEAL_TICK;
      card.style.setProperty('--deal-delay', `${delay}ms`);
      card.dataset.deal = 'play';
      const settle = (e: AnimationEvent) => {
        if (e.target !== card) return;
        card.removeEventListener('animationend', settle);
        delete card.dataset.deal;
        card.style.removeProperty('--deal-delay');
      };
      card.addEventListener('animationend', settle);
      const prize = card.querySelector<HTMLElement>('[data-prize]');
      // Starts on the card's last tick, as its echoes collapse.
      if (prize) tickPrize(prize, delay + 340);
    };

    const observer = new IntersectionObserver((entries) => {
      entries
        .filter((entry) => entry.isIntersecting)
        .forEach((entry, order) => {
          observer.unobserve(entry.target);
          deal(entry.target as HTMLElement, order);
        });
    }, { threshold: 0.2, rootMargin: '0px 0px -6% 0px' });
    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener('DOMContentLoaded', () => {
    initEventWallDrop();
    initCourtTriggers();
    initCardDeal();
  });
</script>
