---
import { siteConfig } from '../config/site.config';
const { sponsors } = siteConfig;

// Per-tier logo-tile sizing — presentational, matched by tier title.
const tileSizing: Record<string, { minWidth: string; height: string; maxHeight: string }> = {
  'Title Sponsors': { minWidth: '240px', height: '110px', maxHeight: '70px' },
  'Event Sponsors': { minWidth: '200px', height: '88px', maxHeight: '50px' },
  'Partners': { minWidth: '140px', height: '76px', maxHeight: '40px' },
};
---

<div style="height:2px;background:var(--ink)"></div>
<section id="sponsors" class="cv-auto" style="position:relative;max-width:1180px;margin:0 auto;padding:44px 24px 56px">
  <h2 style="margin:0 0 30px;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(40px,7vw,80px);letter-spacing:-.03em;line-height:.85;text-shadow:2px 0 0 rgba(226,59,46,.42),-2px 1px 0 rgba(47,143,208,.34)">{sponsors.heading}</h2>
  <div style="font-family:'Shrikhand',serif;font-size:clamp(16px,2.4vw,22px);color:var(--r6);transform:rotate(2.2deg);margin:-22px 0 28px;display:inline-block">{sponsors.subheading}</div>

  <div style="display:flex;flex-direction:column;gap:20px">
    {sponsors.tiers.map((tier) => {
      const sizing = tileSizing[tier.title] ?? tileSizing['Partners'];
      const showLabels = tier.title !== 'Partners';
      return (
        <div style="background:var(--card);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:20px">
          <div style="display:flex;align-items:center;gap:12px;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:16px">
            ◆ {tier.title}<span style="height:2px;flex:1;background:var(--line)"></span>
          </div>
          <div style={`display:grid;grid-template-columns:repeat(auto-fit,minmax(${sizing.minWidth},1fr));gap:14px`}>
            {tier.logos.map((sponsor) =>
              showLabels ? (
                <div>
                  <div style="font-family:inherit;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink2);margin-bottom:8px">{sponsor.label}</div>
                  <div style={`background:${sponsor.background ?? 'var(--wcard)'};border:2px solid var(--ink);height:${sizing.height};display:grid;place-items:center`}>
                    {sponsor.href ? (
                      <a href={sponsor.href} target="_blank" rel="noopener" style="display:grid;place-items:center;width:100%;height:100%">
                        <img src={sponsor.logo} alt={sponsor.alt} width="160" height="70" loading="lazy" decoding="async" style={`max-height:${sizing.maxHeight};max-width:80%;width:auto;height:auto`} />
                      </a>
                    ) : (
                      <img src={sponsor.logo} alt={sponsor.alt} width="160" height="70" loading="lazy" decoding="async" style={`max-height:${sizing.maxHeight};max-width:80%;width:auto;height:auto`} />
                    )}
                  </div>
                </div>
              ) : (
                <div style={`background:var(--wcard);border:2px solid var(--ink);height:${sizing.height};display:grid;place-items:center`}>
                  {sponsor.href ? (
                    <a href={sponsor.href} target="_blank" rel="noopener" style="display:grid;place-items:center;width:100%;height:100%">
                      <img src={sponsor.logo} alt={sponsor.alt} width="50" height="40" loading="lazy" decoding="async" style={`max-height:${sizing.maxHeight};width:auto`} />
                    </a>
                  ) : (
                    <img src={sponsor.logo} alt={sponsor.alt} width="50" height="40" loading="lazy" decoding="async" style={`max-height:${sizing.maxHeight};width:auto`} />
                  )}
                </div>
              )
            )}
          </div>
        </div>
      );
    })}

    <!-- Alumni Sponsors -->
    <div style="background:var(--card);border:2px solid var(--ink);box-shadow:5px 5px 0 var(--ink);padding:20px">
      <div style="display:flex;align-items:center;gap:12px;font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--acc);margin-bottom:6px">
        ◆ Alumni Sponsors<span style="height:2px;flex:1;background:var(--line)"></span>
      </div>
      <div style="font-size:13px;color:var(--ink2);margin-bottom:14px">{sponsors.alumniIntro}</div>
      <div style="column-width:230px;column-gap:28px">
        {sponsors.alumni.map((alum) => (
          <div style="display:flex;align-items:baseline;gap:8px;padding:7px 0;border-bottom:1px dashed var(--line);break-inside:avoid"><span style="color:var(--acc);font-size:10px">◆</span><span style="font-size:14.5px;font-weight:600;color:var(--ink)">{alum.name}</span><span style="font-family:inherit;font-size:11px;color:var(--ink2);margin-left:auto">{alum.batch}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>
