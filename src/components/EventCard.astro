---
import type { EventDetail } from '../config/site.config';

export interface CardStyle {
  shadow: string;
  rotate: string;
  /** Full border declaration, e.g. "border:2px dashed var(--ink);". Defaults to a solid ink border. */
  border?: string;
}

interface Props {
  event: EventDetail;
  cardStyle?: CardStyle;
  prizeLabel: string;
  /** Badge text shown when `event.isSignature` is true, e.g. "SIGNATURE" */
  signatureBadge?: string;
}

const { event: ev, cardStyle, prizeLabel, signatureBadge } = Astro.props;

const logoStyle = `width:62px;height:62px;display:block;margin-bottom:14px;object-fit:contain${
  ev.logoFilter ? `;filter:${ev.logoFilter}` : ''
}`;
// A "to be announced" prize is a phrase rather than a figure, so it needs to sit smaller to fit the row.
const prizeSize = ev.prize.trim().startsWith('₹') ? '20px' : '16px';
---

<div
  id={`e-${ev.key}`}
  class="ecard"
  data-open={ev.key}
  style={`position:relative;background:var(--card);${cardStyle?.border ?? 'border:2px solid var(--ink);'}padding:22px 20px;--shade:${cardStyle?.shadow ?? 'var(--ink)'};--tilt:${cardStyle?.rotate ?? 'rotate(0deg)'};display:flex;flex-direction:column;scroll-margin-top:70px;cursor:pointer`}
>
  {ev.isSignature && signatureBadge && (
    <div style="position:absolute;top:-16px;left:-12px;z-index:5;transform:rotate(-10deg);display:flex;flex-direction:column;align-items:center;gap:1px;pointer-events:none">
      <svg width="34" height="26" viewBox="0 0 34 26" style="display:block"><path d="M3 22 L1.5 7 L9.5 13 L17 2.5 L24.5 13 L32.5 7 L31 22 Z" fill="#f0a500" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"></path><circle cx="17" cy="17" r="2" fill="var(--ink)"></circle></svg>
      <span style="font-family:inherit;font-size:9px;font-weight:700;letter-spacing:.1em;color:#fff;background:var(--ink);padding:2px 6px 1px">{signatureBadge}</span>
    </div>
  )}
  <img src={ev.logo} alt={`${ev.name} Logo`} width="62" height="62" loading="lazy" decoding="async" style={logoStyle} />
  <div style="font-family:inherit;font-size:11px;letter-spacing:.08em;color:var(--acc);font-weight:700;margin-bottom:6px">{ev.tag}</div>
  <h4 style="margin:0 0 8px;font-family:inherit;font-size:20px;font-weight:700">{ev.name}</h4>
  <div style="font-size:14px;line-height:1.5;color:var(--ink2);flex:1">{ev.shortDescription}</div>
  <div style="margin-top:16px;padding-top:14px;border-top:1.5px dashed var(--line);display:flex;justify-content:space-between;align-items:baseline">
    <span style="font-family:inherit;font-size:11px;color:var(--ink2)">{prizeLabel}</span>
    <span data-prize style={`font-size:${prizeSize};font-weight:800;color:var(--acc);font-variant-numeric:tabular-nums;text-align:right`}>{ev.prize}</span>
  </div>
</div>

<style>
  /* ACHRONOS motion, kept to the site's hard offsets and stepped timing: amber
     is the past, ink the present and teal the future, the same reading the
     intro gives its echo layers. Tilt and shade arrive as custom properties so
     these rules, not the inline style, own transform and box-shadow. */
  .ecard {
    transform: var(--tilt);
    box-shadow: 5px 5px 0 var(--shade);
    transition: transform .16s steps(2, end), box-shadow .16s steps(2, end);
  }

  /* Hover splits the one shadow into past, present and future. */
  @media (hover: hover) {
    .ecard:hover {
      transform: var(--tilt) translate(-3px, -3px);
      box-shadow: 4px 4px 0 var(--acc2), 8px 8px 0 var(--ink), 12px 12px 0 var(--teal);
    }
  }

  .ecard:active {
    transform: var(--tilt) translate(3px, 3px);
    box-shadow: 1px 1px 0 var(--shade);
    transition-duration: 0s;
  }

  /* The deal-in: the card lands trailing a past echo up-left and a future echo
     down-right, and both collapse into its shadow in three ticks. The fill is
     backwards only, so once it ends the hover rules above take over again. */
  .ecard[data-deal='pending'] { opacity: 0; }

  .ecard[data-deal='play'] {
    animation: ecardEchoArrive .48s var(--deal-delay, 0s) backwards;
  }

  @keyframes ecardEchoArrive {
    0% {
      opacity: 0;
      animation-timing-function: steps(1, end);
    }
    8% {
      opacity: 1;
      translate: 0 -14px;
      box-shadow: -16px -8px 0 var(--acc2), 16px 8px 0 var(--teal);
      animation-timing-function: steps(1, end);
    }
    40% {
      opacity: 1;
      translate: 0 -6px;
      box-shadow: -7px -3px 0 var(--acc2), 5px 5px 0 var(--shade), 9px 9px 0 var(--teal);
      animation-timing-function: steps(1, end);
    }
    72%, 100% {
      opacity: 1;
      translate: 0 0;
      box-shadow: 5px 5px 0 var(--shade);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ecard { transition: none; }
    .ecard[data-deal] { opacity: 1; animation: none; }
  }
</style>
