---
import { siteConfig } from '../config/site.config';
const { footer, event } = siteConfig;
---

<footer id="about" class="cv-auto" style="background:var(--term);color:#e9dcc6;padding:56px 0 0">
  <div style="display:flex;height:9px">
    <i style="flex:1;background:#2f8fd0"></i>
    <i style="flex:1;background:#e23b5a"></i>
    <i style="flex:1;background:#f0a500"></i>
    <i style="flex:1;background:#241a12"></i>
    <i style="flex:1;background:#e23b2e"></i>
    <i style="flex:1;background:#4ea36a"></i>
    <i style="flex:1;background:#5150ad"></i>
    <i style="flex:1;background:#8e4fa8"></i>
  </div>
  
  <div style="max-width:1180px;margin:0 auto;padding:40px 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
    <!-- Department & Org Info -->
    <div>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px">
        <div style="width:56px;height:56px;background:var(--acc);display:grid;place-items:center;border:2px solid #4a3a24">
          <!-- The favicon mark recolours itself by browser theme, so it is
               forced to white here rather than trusted to land on white. -->
          <img
            src="/assets/favicon.svg"
            alt=""
            width="32"
            height="32"
            loading="lazy"
            decoding="async"
            style="display:block;width:32px;height:32px;filter:brightness(0) invert(1)"
          />
        </div>
        <div>
          <div style="font-family:'Anton',sans-serif;font-size:26px">{event.name.toUpperCase()}</div>
          <div style="font-family:inherit;font-size:12px;color:#8a7a5c">{event.volumeLabel}</div>
        </div>
      </div>
      <p style="font-size:14px;line-height:1.7;color:#c9b48c;margin:0">
        Presented by the <b style="color:#e9dcc6">{event.organizer.name}</b><br />
        {event.organizer.department}<br />
        {event.organizer.collegeName}
      </p>
    </div>

    <!-- Location -->
    <div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:14px">Location</div>
      <p style="font-size:14px;line-height:1.8;color:#c9b48c;margin:0">
        {footer.addressLines.map((line, i) => (
          <>{line}{i < footer.addressLines.length - 1 && <br />}</>
        ))}
      </p>
      <a href={footer.mapsUrl} target="_blank" rel="noopener" style="display:inline-block;margin-top:12px;font-size:13px;font-weight:700;color:#e9dcc6;border:2px solid #4a3a24;background:#2f2114;padding:8px 14px">{footer.mapsLabel}</a>
    </div>

    <!-- Contacts -->
    <div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:14px">Contacts</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px 20px">
        {footer.contacts.map((contact) => (
          <div><div style="font-weight:700;font-size:14.5px;color:#e9dcc6">{contact.name}</div><div style="font-size:12px;color:#8a7a5c;font-style:italic">{contact.role}</div><div style="font-size:13.5px;color:#c9b48c;margin-top:3px">{contact.phone}</div></div>
        ))}
      </div>
      <p style="font-size:14px;margin:16px 0 0;color:#c9b48c">✉ <a href={`mailto:${footer.email}`} style="color:#e9dcc6">{footer.email}</a></p>
    </div>

    <!-- Quick Links & Social -->
    <div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:14px">Links</div>
      <div style="display:flex;flex-direction:column;gap:9px;font-size:14px">
        {footer.links.map((link) => (
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined} style="color:#c9b48c">{link.label}</a>
        ))}
      </div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin:20px 0 14px">Social Media</div>
      <div style="display:flex;gap:10px">
        <a href={footer.socials[0].href} title={footer.socials[0].label} target={footer.socials[0].external ? '_blank' : undefined} rel={footer.socials[0].external ? 'noopener' : undefined} style="width:36px;height:36px;display:grid;place-items:center;background:#2f2114;border:2px solid #4a3a24">
          <svg viewBox="0 0 20 20" width="17" height="17"><rect x="3" y="3" width="14" height="14" rx="4" fill="none" stroke="#e9dcc6" stroke-width="2"></rect><circle cx="10" cy="10" r="3.2" fill="none" stroke="#e9dcc6" stroke-width="2"></circle><circle cx="14.5" cy="5.5" r="1.1" fill="#e9dcc6"></circle></svg>
        </a>
        <a href={footer.socials[1].href} title={footer.socials[1].label} target={footer.socials[1].external ? '_blank' : undefined} rel={footer.socials[1].external ? 'noopener' : undefined} style="width:36px;height:36px;display:grid;place-items:center;background:#2f2114;border:2px solid #4a3a24">
          <svg viewBox="0 0 20 20" width="17" height="17"><text x="10" y="14" text-anchor="middle" font-family="'Bricolage Grotesque',sans-serif" font-weight="bold" font-size="10" fill="#e9dcc6">in</text></svg>
        </a>
        <a href={footer.socials[2].href} title={footer.socials[2].label} target={footer.socials[2].external ? '_blank' : undefined} rel={footer.socials[2].external ? 'noopener' : undefined} style="width:36px;height:36px;display:grid;place-items:center;background:#2f2114;border:2px solid #4a3a24">
          <svg viewBox="0 0 20 20" width="17" height="17"><rect x="3" y="5" width="14" height="10" fill="none" stroke="#e9dcc6" stroke-width="2"></rect><polyline points="3,5 10,11 17,5" fill="none" stroke="#e9dcc6" stroke-width="2"></polyline></svg>
        </a>
      </div>
    </div>
  </div>

  <div style="border-top:1px solid #3a2c1a;padding:16px 24px;text-align:center;font-family:inherit;font-size:11.5px;color:#7a6650">
    {footer.copyright}
  </div>
</footer>
