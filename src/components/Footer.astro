<footer id="about" class="cv-auto" style="background:var(--term);color:#e9dcc6;padding:56px 0 0">
  <div style="display:flex;height:9px">
    <i style="flex:1;background:#2f8fd0"></i>
    <i style="flex:1;background:#e23b5a"></i>
    <i style="flex:1;background:#f0a500"></i>
    <i style="flex:1;background:#241a12"></i>
    <i style="flex:1;background:#e23b2e"></i>
    <i style="flex:1;background:#4ea36a"></i>
    <i style="flex:1;background:#5150ad"></i>
    <i style="flex:1;background:#8e4fa8"></i>
  </div>
  
  <div style="max-width:1180px;margin:0 auto;padding:40px 24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
    <!-- Department & Org Info -->
    <div>
      <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px">
        <div style="width:56px;height:56px;background:var(--acc);display:grid;place-items:center;border:2px solid #4a3a24">
          <span style="font-family:'Anton',sans-serif;font-size:24px;color:#fff">AX</span>
        </div>
        <div>
          <div style="font-family:'Anton',sans-serif;font-size:26px">AXIOS</div>
          <div style="font-family:inherit;font-size:12px;color:#8a7a5c">Vol. III · MMXXVI</div>
        </div>
      </div>
      <p style="font-size:14px;line-height:1.7;color:#c9b48c;margin:0">
        Presented by the <b style="color:#e9dcc6">Computational Sciences Association (CSA)</b><br />
        Department of Applied Mathematics &amp; Computational Sciences<br />
        PSG College of Technology, Coimbatore — 641004
      </p>
    </div>

    <!-- Location -->
    <div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:14px">Location</div>
      <p style="font-size:14px;line-height:1.8;color:#c9b48c;margin:0">
        PSG College of Technology,<br />
        Avinashi Rd, Peelamedu,<br />
        Coimbatore, Tamil Nadu 641004
      </p>
      <a href="https://maps.google.com/?q=PSG+College+of+Technology+Coimbatore" target="_blank" rel="noopener" style="display:inline-block;margin-top:12px;font-size:13px;font-weight:700;color:#e9dcc6;border:2px solid #4a3a24;background:#2f2114;padding:8px 14px">▸ Open in Maps</a>
    </div>

    <!-- Contacts -->
    <div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:14px">Contacts</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px 20px">
        <div><div style="font-weight:700;font-size:14.5px;color:#e9dcc6">Dinesh</div><div style="font-size:12px;color:#8a7a5c;font-style:italic">Secretary</div><div style="font-size:13.5px;color:#c9b48c;margin-top:3px">+91 90000 00001</div></div>
        <div><div style="font-weight:700;font-size:14.5px;color:#e9dcc6">Bhuvanesh</div><div style="font-size:12px;color:#8a7a5c;font-style:italic">Executive Co-ordinator</div><div style="font-size:13.5px;color:#c9b48c;margin-top:3px">+91 90000 00002</div></div>
        <div><div style="font-weight:700;font-size:14.5px;color:#e9dcc6">Aravind</div><div style="font-size:12px;color:#8a7a5c;font-style:italic">Tech Co-ordinator</div><div style="font-size:13.5px;color:#c9b48c;margin-top:3px">+91 90000 00003</div></div>
        <div><div style="font-weight:700;font-size:14.5px;color:#e9dcc6">Ravi Varma</div><div style="font-size:12px;color:#8a7a5c;font-style:italic">Accommodation Co-ordinator</div><div style="font-size:13.5px;color:#c9b48c;margin-top:3px">+91 90000 00004</div></div>
      </div>
      <p style="font-size:14px;margin:16px 0 0;color:#c9b48c">✉ <a href="mailto:axios@psgtech.ac.in" style="color:#e9dcc6">axios@psgtech.ac.in</a></p>
    </div>

    <!-- Quick Links & Social -->
    <div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin-bottom:14px">Links</div>
      <div style="display:flex;flex-direction:column;gap:9px;font-size:14px">
        <a href="#about" style="color:#c9b48c">▸ Axios Web App</a>
        <a href="https://www.psgtech.edu" target="_blank" rel="noopener" style="color:#c9b48c">▸ PSG College of Technology</a>
      </div>
      <div style="font-family:inherit;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--acc2);margin:20px 0 14px">Social Media</div>
      <div style="display:flex;gap:10px">
        <a href="#about" title="Instagram" style="width:36px;height:36px;display:grid;place-items:center;background:#2f2114;border:2px solid #4a3a24">
          <svg viewBox="0 0 20 20" width="17" height="17"><rect x="3" y="3" width="14" height="14" rx="4" fill="none" stroke="#e9dcc6" stroke-width="2"></rect><circle cx="10" cy="10" r="3.2" fill="none" stroke="#e9dcc6" stroke-width="2"></circle><circle cx="14.5" cy="5.5" r="1.1" fill="#e9dcc6"></circle></svg>
        </a>
        <a href="#about" title="LinkedIn" style="width:36px;height:36px;display:grid;place-items:center;background:#2f2114;border:2px solid #4a3a24">
          <svg viewBox="0 0 20 20" width="17" height="17"><text x="10" y="14" text-anchor="middle" font-family="'Bricolage Grotesque',sans-serif" font-weight="bold" font-size="10" fill="#e9dcc6">in</text></svg>
        </a>
        <a href="mailto:axios@psgtech.ac.in" title="Email" style="width:36px;height:36px;display:grid;place-items:center;background:#2f2114;border:2px solid #4a3a24">
          <svg viewBox="0 0 20 20" width="17" height="17"><rect x="3" y="5" width="14" height="10" fill="none" stroke="#e9dcc6" stroke-width="2"></rect><polyline points="3,5 10,11 17,5" fill="none" stroke="#e9dcc6" stroke-width="2"></polyline></svg>
        </a>
      </div>
    </div>
  </div>

  <div style="border-top:1px solid #3a2c1a;padding:16px 24px;text-align:center;font-family:inherit;font-size:11.5px;color:#7a6650">
    © MMXXVI Computational Sciences Association · PSG College of Technology — best viewed at 800×600 or higher ✦ Not licensed for resale to any garage startup.
  </div>
</footer>
