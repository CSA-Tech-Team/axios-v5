---
import Layout from '../layouts/Layout.astro';
import AchronosIntro from '../components/AchronosIntro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PastEditions from '../components/PastEditions.astro';
import PrizePool from '../components/PrizePool.astro';
import Lineup from '../components/Lineup.astro';
import SlotMachine from '../components/SlotMachine.astro';
import Team from '../components/Team.astro';
import Sponsors from '../components/Sponsors.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import EventModal from '../components/EventModal.astro';

// Enabled by default. Honour the old deployment flag during migration.
const showIntro = (import.meta.env.PUBLIC_ACHRONOS_INTRO ?? import.meta.env.PUBLIC_WARP_INTRO ?? 'true') === 'true';
---

<Layout>
  {showIntro && <AchronosIntro />}
  <Header />
  <main>
    <Hero />
    <PastEditions />
    <PrizePool />
    <Lineup />
    <SlotMachine />
    <Team />
    <Sponsors />
    <Faq />
  </main>
  <Footer />
  <EventModal />
</Layout>
