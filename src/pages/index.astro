---
import Layout from '../layouts/Layout.astro';
import WarpIntro from '../components/WarpIntro.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PastEditions from '../components/PastEditions.astro';
import PrizePool from '../components/PrizePool.astro';
import Lineup from '../components/Lineup.astro';
import SlotMachine from '../components/SlotMachine.astro';
import Team from '../components/Team.astro';
import Sponsors from '../components/Sponsors.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import EventModal from '../components/EventModal.astro';

// Landing animation toggle, read at build time from .env.
// PUBLIC_WARP_INTRO=true plays the hyperspace intro; anything else — including
// the variable being absent — skips it. Skipping also keeps three.js out of the
// client bundle entirely, since the component's script never ships.
const showWarpIntro = import.meta.env.PUBLIC_WARP_INTRO === 'true';
---

<Layout>
  {showWarpIntro && <WarpIntro />}
  <Header />
  <main>
    <Hero />
    <PastEditions />
    <PrizePool />
    <Lineup />
    <SlotMachine />
    <Team />
    <Sponsors />
    <Faq />
  </main>
  <Footer />
  <EventModal />
</Layout>
