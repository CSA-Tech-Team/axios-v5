---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PastEditions from '../components/PastEditions.astro';
import PrizePool from '../components/PrizePool.astro';
import Lineup from '../components/Lineup.astro';
import SlotMachine from '../components/SlotMachine.astro';
import Team from '../components/Team.astro';
import Sponsors from '../components/Sponsors.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import EventModal from '../components/EventModal.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <PastEditions />
    <PrizePool />
    <Lineup />
    <SlotMachine />
    <Team />
    <Sponsors />
    <Faq />
  </main>
  <Footer />
  <EventModal />
</Layout>
