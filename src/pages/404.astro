---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site.config';

// Emitted as /404.html. Cloudflare Pages serves it automatically for unknown
// paths; nginx is pointed at it with `error_page 404 /404.html`. Both return a
// real 404 status, so search engines drop last year's URLs instead of
// treating them as duplicates of the homepage.
---

<Layout
  title={`Page not found | ${siteConfig.event.name} '26`}
  description="That page is not part of the Axios '26 site. Head back to the homepage for events, prizes and registration."
>
  <main
    style="min-height:80vh;display:grid;place-items:center;padding:80px 24px;text-align:center"
  >
    <div style="max-width:52ch">
      <div
        style="display:inline-block;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;background:var(--ink);color:var(--paper);padding:5px 10px;transform:rotate(-1.5deg);margin-bottom:18px"
      >
        Error 404
      </div>

      <h1
        style="margin:0;font-family:'Anton',sans-serif;font-weight:400;font-size:clamp(72px,18vw,180px);line-height:.82;letter-spacing:.01em;color:var(--acc);text-shadow:4px 4px 0 var(--acc2),8px 8px 0 rgba(36,26,18,.18)"
      >
        404
      </h1>

      <h2
        style="margin:18px 0 0;font-family:'Futura','Jost','Century Gothic',sans-serif;font-size:clamp(24px,4.4vw,40px);line-height:.95;letter-spacing:-.02em"
      >
        THIS PAGE<br />WENT MISSING
      </h2>

      <p style="margin:18px 0 0;font-size:16px;line-height:1.55;color:var(--ink2)">
        The page you asked for is not part of the Axios '26 site. It may have
        belonged to an earlier edition.
      </p>

      <a
        href="/"
        style="display:inline-block;margin-top:28px;background:var(--acc);color:#fff;border:2px solid var(--ink);box-shadow:4px 5px 0 var(--ink);padding:14px 22px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;text-decoration:none;transform:rotate(-1deg)"
      >
        ▶ Back to the homepage
      </a>

      <div
        style="font-family:'Shrikhand',serif;font-size:17px;color:var(--teal);transform:rotate(1.8deg);margin-top:34px"
      >
        nothing to see here ✦
      </div>
    </div>
  </main>
</Layout>
